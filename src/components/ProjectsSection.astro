---
import Icon from "@/components/Icon.astro";
import ProjectLivePreview from "@/components/ProjectLivePreview.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { buttonVariants } from "@/components/ui/button";

type Props = {
  projects: {
    eyebrow: string;
    title: string;
    description: string;
    featured: {
      title: string;
      description: string;
      tags: readonly string[];
      href: string;
      preview?: {
        browserLabel: string;
        status: string;
        note: string;
        currentLabel: string;
        currentDescription: string;
        futureLabel: string;
        futureDescription: string;
        stalledTitle: string;
        stalledDescription: string;
        openLabel: string;
      };
    };
    archiveTitle: string;
    archiveDescription: string;
  };
};

const { projects } = Astro.props;
---

<section id="projects" class="px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <SectionHeading
      eyebrow={projects.eyebrow}
      title={projects.title}
      description={projects.description}
      align="center"
    />

    <div class="mx-auto mt-12 max-w-7xl">
      <article class="surface-card noise-mask overflow-hidden rounded-[2.4rem] p-6 sm:p-8 lg:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.06fr_0.94fr] lg:items-center">
          {projects.featured.preview && (
            <div class="order-1 lg:order-2">
              <ProjectLivePreview
                title={projects.featured.title}
                href={projects.featured.href}
                preview={projects.featured.preview}
              />
            </div>
          )}

          <div class="order-2 flex flex-col lg:order-1">
            <div class="flex flex-wrap gap-3">
              <span class="eyebrow rounded-full border border-[color:color-mix(in_oklab,var(--color-signal)_20%,transparent)] bg-[color:color-mix(in_oklab,var(--color-signal)_10%,transparent)] px-4 py-2 text-[0.65rem] font-semibold text-[color:var(--color-signal-ink)]">
                Featured preview
              </span>
              {projects.featured.tags.map((tag) => (
                <span class="eyebrow rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_16%,white)] bg-[rgba(3,71,128,0.12)] px-4 py-2 text-[0.65rem] font-semibold text-[color:var(--color-ink)]">
                  {tag}
                </span>
              ))}
            </div>

            <div class="mt-8">
              <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
                Current progress and future result
              </p>
              <h3 class="mt-4 font-display text-4xl leading-none text-[color:var(--color-ink)] sm:text-5xl">
                {projects.featured.title}
              </h3>
              <p class="mt-5 max-w-xl text-base leading-7 text-[color:var(--color-copy)]">
                {projects.featured.description}
              </p>
            </div>

            {projects.featured.preview && (
              <div class="mt-8 grid gap-4 sm:grid-cols-2">
                <div class="rounded-[1.6rem] border border-[color:color-mix(in_oklab,var(--color-signal)_20%,transparent)] bg-[color:color-mix(in_oklab,var(--color-signal)_8%,transparent)] p-5">
                  <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
                    {projects.featured.preview.currentLabel}
                  </p>
                  <p class="mt-3 text-sm leading-7 text-[color:var(--color-copy)]">
                    {projects.featured.preview.currentDescription}
                  </p>
                </div>

                <div class="rounded-[1.6rem] border border-[color:color-mix(in_oklab,var(--color-accent)_18%,transparent)] bg-[color:color-mix(in_oklab,var(--color-accent)_7%,transparent)] p-5">
                  <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-accent)]">
                    {projects.featured.preview.futureLabel}
                  </p>
                  <p class="mt-3 text-sm leading-7 text-[color:var(--color-copy)]">
                    {projects.featured.preview.futureDescription}
                  </p>
                </div>
              </div>
            )}

            <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center">
              <a
                href={projects.featured.href}
                target="_blank"
                rel="noreferrer"
                class={buttonVariants({ variant: "default", size: "default" })}
              >
                {projects.featured.preview?.openLabel ?? "Open live project"}
                <Icon name="arrow-up-right" size={18} />
              </a>

              <p class="text-sm leading-7 text-[color:var(--color-copy)]">
                Tap through the preview above on mobile, or open the full project in a new tab for the complete browsing context.
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="surface-card mx-auto mt-8 max-w-6xl rounded-[2rem] p-6 text-center sm:p-8">
      <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
        {projects.archiveTitle}
      </p>

      <div class="mt-5 flex flex-col items-center gap-4">
        <p class="max-w-2xl text-base leading-7 text-[color:var(--color-copy)]">
          {projects.archiveDescription}
        </p>

        <div class="rounded-[1.25rem] border border-dashed border-[color:color-mix(in_oklab,var(--color-muted)_36%,transparent)] px-5 py-4 text-sm text-[color:var(--color-copy)]">
          Empty state ready for the next case study.
        </div>
      </div>
    </div>
  </div>
</section>
