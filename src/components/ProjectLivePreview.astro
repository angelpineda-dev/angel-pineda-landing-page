---
import { buttonVariants } from "@/components/ui/button";

type ProjectPreview = {
  browserLabel: string;
  status: string;
  note: string;
  stalledTitle: string;
  stalledDescription: string;
  openLabel: string;
};

type Props = {
  title: string;
  href: string;
  preview: ProjectPreview;
};

const { title, href, preview } = Astro.props;
---

<div
  class="project-preview-root"
  data-project-preview-root
  data-state="loading"
>
  <div class="project-preview-shell">
    <div class="project-preview-topbar">
      <div class="project-preview-dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <p class="project-preview-domain">{preview.browserLabel}</p>
      <span class="project-preview-badge">{preview.status}</span>
    </div>

    <div class="project-preview-window" data-project-preview-window>
      <div class="project-preview-grid" aria-hidden="true"></div>
      <div class="project-preview-stage">
        <div class="project-preview-viewport" data-project-preview-viewport>
          <iframe
            data-project-preview-iframe
            src={href}
            title={`Live preview of ${title}`}
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
            class="project-preview-iframe"
          ></iframe>
        </div>
      </div>

      <div
        class="project-preview-loading placeholder-sheen"
        data-project-preview-loading
        aria-live="polite"
      >
        <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
          Loading
        </p>
        <p class="mt-3 max-w-xs text-sm leading-6 text-[color:var(--color-copy)]">
          Syncing the current live build into the frame. On mobile, third-party embeds can take a moment to appear.
        </p>
      </div>

      <div class="project-preview-stalled" data-project-preview-stalled hidden aria-live="polite">
        <button
          type="button"
          class="project-preview-stalled-close"
          data-project-preview-stalled-dismiss
          aria-label="Close preview delay message"
        >
          <span aria-hidden="true">×</span>
        </button>

        <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
          Taking longer than expected
        </p>
        <h4 class="mt-3 font-display text-2xl leading-none text-[color:var(--color-ink)] sm:text-[1.9rem]">
          {preview.stalledTitle}
        </h4>
        <p class="mt-3 max-w-sm text-sm leading-7 text-[color:var(--color-copy)]">
          {preview.stalledDescription}
        </p>

        <div class="project-preview-stalled-actions">
          <a
            href={href}
            target="_blank"
            rel="noreferrer"
            class={buttonVariants({ variant: "outline", size: "default" })}
          >
            {preview.openLabel}
          </a>

          <button
            type="button"
            class="project-preview-stalled-wait"
            data-project-preview-stalled-dismiss
          >
            Keep waiting
          </button>
        </div>
      </div>
    </div>

    <p class="project-preview-note">
      {preview.note}
    </p>
  </div>
</div>

<script>
  const previewRoots = document.querySelectorAll("[data-project-preview-root]");

  for (const root of previewRoots) {
    if (!(root instanceof HTMLElement) || root.dataset.bound === "true") {
      continue;
    }

    root.dataset.bound = "true";

    const iframe = root.querySelector("[data-project-preview-iframe]");
    const loading = root.querySelector("[data-project-preview-loading]");
    const stalledMessage = root.querySelector("[data-project-preview-stalled]");
    const previewWindow = root.querySelector("[data-project-preview-window]");
    const previewViewport = root.querySelector("[data-project-preview-viewport]");
    const dismissButtons = root.querySelectorAll("[data-project-preview-stalled-dismiss]");

    if (
      !(iframe instanceof HTMLIFrameElement) ||
      !(loading instanceof HTMLElement) ||
      !(stalledMessage instanceof HTMLElement) ||
      !(previewWindow instanceof HTMLElement) ||
      !(previewViewport instanceof HTMLElement)
    ) {
      continue;
    }

    let settled = false;
    let stalled = false;
    let stalledDismissed = false;
    const mobileQuery = window.matchMedia("(max-width: 767px)");

    const syncViewport = () => {
      if (!mobileQuery.matches) {
        previewViewport.style.removeProperty("--preview-width");
        previewViewport.style.removeProperty("--preview-height");
        previewViewport.style.removeProperty("--preview-scale");
        root.dataset.previewMode = "browser";
        return;
      }

      const targetWidth = 390;
      const targetHeight = 844;
      const availableWidth = previewWindow.clientWidth - 24;
      const availableHeight = previewWindow.clientHeight - 24;

      if (availableWidth <= 0 || availableHeight <= 0) {
        return;
      }

      const scale = Math.min(availableWidth / targetWidth, availableHeight / targetHeight);

      previewViewport.style.setProperty("--preview-width", `${targetWidth}`);
      previewViewport.style.setProperty("--preview-height", `${targetHeight}`);
      previewViewport.style.setProperty("--preview-scale", `${Math.min(scale, 1)}`);
      root.dataset.previewMode = "phone";
    };

    const resizeObserver = new ResizeObserver(syncViewport);
    resizeObserver.observe(previewWindow);
    syncViewport();

    const showLoaded = () => {
      settled = true;
      root.dataset.state = "loaded";
      loading.hidden = true;
      stalledMessage.hidden = true;
    };

    const showStalled = () => {
      if (settled || stalled || stalledDismissed) {
        return;
      }

      stalled = true;
      root.dataset.state = "stalled";
      loading.hidden = true;
      stalledMessage.hidden = false;
    };

    const dismissStalled = () => {
      stalledDismissed = true;
      stalled = false;
      stalledMessage.hidden = true;
      root.dataset.state = settled ? "loaded" : "waiting";

      if (!settled) {
        loading.hidden = true;
      }
    };

    const isCoarsePointer = window.matchMedia("(pointer: coarse)").matches;
    const stalledDelay = isCoarsePointer ? 12000 : 5000;
    const stalledTimer = window.setTimeout(() => {
      if (!settled) {
        showStalled();
      }
    }, stalledDelay);

    for (const dismissButton of dismissButtons) {
      if (dismissButton instanceof HTMLButtonElement) {
        dismissButton.addEventListener("click", dismissStalled);
      }
    }

    iframe.addEventListener(
      "load",
      () => {
        window.clearTimeout(stalledTimer);
        showLoaded();
      },
      { once: true }
    );

    window.addEventListener(
      "pagehide",
      () => {
        window.clearTimeout(stalledTimer);
        resizeObserver.disconnect();
      },
      { once: true }
    );
  }
</script>

<style>
  .project-preview-shell {
    border: 1px solid var(--color-frame);
    border-radius: 2rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-paper-strong) 88%, var(--color-signal) 12%) 0%,
        color-mix(in oklab, var(--color-paper-soft) 86%, var(--color-signal) 14%) 100%
      );
    box-shadow: var(--shadow-strong);
    padding: 0.875rem;
  }

  :global(.dark) .project-preview-shell {
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, #131313 76%, var(--color-signal) 24%) 0%,
        color-mix(in oklab, #131313 84%, var(--color-signal) 16%) 100%
      );
  }

  .project-preview-topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 0.125rem 0.875rem;
  }

  .project-preview-dots {
    display: inline-flex;
    gap: 0.45rem;
  }

  .project-preview-dots span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-muted) 30%, white);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-muted) 55%, transparent);
  }

  .project-preview-dots span:nth-child(1) {
    background: color-mix(in oklab, var(--color-accent) 38%, white);
  }

  .project-preview-dots span:nth-child(2) {
    background: color-mix(in oklab, var(--color-signal) 38%, white);
  }

  .project-preview-dots span:nth-child(3) {
    background: color-mix(in oklab, var(--color-ink) 18%, white);
  }

  .project-preview-domain {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-copy);
  }

  .project-preview-badge {
    border: 1px solid color-mix(in oklab, var(--color-signal) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-signal) 12%, transparent);
    padding: 0.48rem 0.78rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-signal-ink);
  }

  .project-preview-window {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-frame);
    border-radius: 1.5rem;
    background: var(--color-paper-strong);
    aspect-ratio: 16 / 11;
  }

  .project-preview-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-frame) 55%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-frame) 55%, transparent) 1px, transparent 1px);
    background-size: 2.25rem 2.25rem;
    mask-image: linear-gradient(180deg, black, transparent 82%);
    opacity: 0.18;
    z-index: 1;
  }

  .project-preview-stage {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .project-preview-viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    border-radius: 1.15rem;
    background: white;
  }

  .project-preview-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: white;
  }

  .project-preview-loading,
  .project-preview-stalled {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    text-align: center;
    z-index: 2;
  }

  .project-preview-loading {
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-paper-strong) 92%, var(--color-signal) 8%) 0%,
        color-mix(in oklab, var(--color-paper-soft) 88%, var(--color-accent) 12%) 100%
      );
    backdrop-filter: blur(10px);
  }

  .project-preview-stalled {
    inset: auto 1rem 1rem;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 1rem 1rem 1.1rem;
    border: 1px solid color-mix(in oklab, var(--color-frame) 82%, transparent);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-paper-strong) 84%, white) 0%,
        color-mix(in oklab, var(--color-paper-soft) 90%, var(--color-signal) 10%) 100%
      );
    box-shadow: 0 18px 32px color-mix(in oklab, var(--color-signal) 12%, transparent);
    text-align: left;
    z-index: 3;
    max-width: min(26rem, calc(100% - 2rem));
    backdrop-filter: blur(16px);
  }

  .project-preview-stalled-close {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid color-mix(in oklab, var(--color-frame) 76%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-paper-strong) 78%, transparent);
    color: var(--color-copy);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .project-preview-stalled-close:hover {
    border-color: color-mix(in oklab, var(--color-accent) 36%, transparent);
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-paper-strong) 88%, white);
  }

  .project-preview-stalled-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.1rem;
  }

  .project-preview-stalled-wait {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-copy);
    cursor: pointer;
    transition: color 180ms ease;
  }

  .project-preview-stalled-wait:hover {
    color: var(--color-ink);
  }

  :global(.dark) .project-preview-stalled {
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, #131313 82%, var(--color-signal) 18%) 0%,
        color-mix(in oklab, #131313 88%, var(--color-accent) 12%) 100%
      );
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.34);
  }

  .project-preview-note {
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-copy);
  }

  .project-preview-root[data-state="loaded"] .project-preview-loading,
  .project-preview-root[data-state="loaded"] .project-preview-stalled {
    display: none;
  }

  .project-preview-root[data-state="stalled"] .project-preview-loading {
    display: none;
  }

    @media (max-width: 767px) {
    .project-preview-shell {
      padding: 0.75rem;
      border-radius: 1.65rem;
    }

    .project-preview-topbar {
      grid-template-columns: auto 1fr;
      row-gap: 0.65rem;
      padding-bottom: 0.75rem;
    }

    .project-preview-badge {
      justify-self: start;
      grid-column: 1 / -1;
      padding-inline: 0.72rem;
      font-size: 0.66rem;
    }

    .project-preview-window {
      aspect-ratio: 9 / 16.6;
      padding: 0.75rem;
      background:
        radial-gradient(circle at top, rgba(3, 71, 128, 0.12), transparent 48%),
        color-mix(in oklab, var(--color-paper-strong) 92%, var(--color-signal) 8%);
    }

    :global(.dark) .project-preview-window {
      background:
        radial-gradient(circle at top, rgba(3, 71, 128, 0.18), transparent 48%),
        color-mix(in oklab, #131313 88%, var(--color-signal) 12%);
    }

    .project-preview-viewport {
      --preview-width: 390;
      --preview-height: 844;
      --preview-scale: 0.72;
      width: calc(var(--preview-width) * var(--preview-scale) * 1px);
      height: calc(var(--preview-height) * var(--preview-scale) * 1px);
      max-width: 100%;
      max-height: 100%;
      border-radius: 1.75rem;
      border: 1px solid color-mix(in oklab, var(--color-frame) 76%, transparent);
      box-shadow:
        0 18px 28px color-mix(in oklab, var(--color-signal) 12%, transparent),
        0 0 0 1px color-mix(in oklab, white 45%, transparent);
    }

    .project-preview-iframe {
      position: absolute;
      inset: 0;
      width: calc(var(--preview-width) * 1px);
      height: calc(var(--preview-height) * 1px);
      transform: scale(var(--preview-scale));
      transform-origin: top left;
    }

    .project-preview-loading {
      padding: 1.35rem;
    }

    .project-preview-stalled {
      inset: auto 0.8rem 0.8rem;
      padding: 0.9rem 0.9rem 1rem;
      border-radius: 1.15rem;
      max-width: calc(100% - 1.6rem);
    }

    .project-preview-stalled-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.7rem;
    }

    .project-preview-stalled-actions :global(a) {
      justify-content: center;
      width: 100%;
    }

    .project-preview-stalled-wait {
      min-height: 2.75rem;
      width: 100%;
      border-radius: 999px;
      background: color-mix(in oklab, var(--color-paper-strong) 78%, transparent);
      border: 1px solid color-mix(in oklab, var(--color-frame) 72%, transparent);
    }

    .project-preview-note {
      font-size: 0.9rem;
      line-height: 1.65;
    }
  }
</style>
