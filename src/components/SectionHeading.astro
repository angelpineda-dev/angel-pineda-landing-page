---
type Props = {
  eyebrow: string;
  title: string;
  description: string;
  align?: "left" | "right";
};

const { eyebrow, title, description, align = "left" } = Astro.props;
const alignment = align === "right" ? "md:text-right md:items-end" : "";
---

<div class:list={["flex max-w-2xl flex-col gap-4", alignment]}>
  <p class="eyebrow text-xs font-semibold text-[color:var(--color-signal-ink)]">
    {eyebrow}
  </p>
  <h2 class="font-display text-4xl leading-[0.95] text-[color:var(--color-ink)] md:text-6xl">
    {title}
  </h2>
  <p class="max-w-xl text-base leading-7 text-[color:var(--color-copy)] md:text-lg">
    {description}
  </p>
</div>
