---
import { buttonVariants } from "@/components/ui/button";
import MobileNav from "@/components/MobileNav.astro";

type Props = {
  items: readonly { href: string; label: string }[];
  whatsappHref: string;
};

const { items, whatsappHref } = Astro.props;
---

<header class="sticky top-0 z-40 px-4 pt-4 sm:px-6">
  <div class="mx-auto flex max-w-7xl items-center justify-between rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_20%,white)] bg-[color:var(--color-surface-strong)] px-4 py-3 shadow-[0_18px_50px_rgba(86,108,117,0.14)] backdrop-blur-xl sm:px-6">
    <a href="#" class="flex flex-col leading-none">
      <span class="font-display text-lg text-[color:var(--color-ink)] sm:text-xl">
        Angel Pineda
      </span>
      <span class="eyebrow mt-1 text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
        Software engineer
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex">
      {items.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-[color:var(--color-muted-deep)] transition-colors hover:text-[color:var(--color-accent)]"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noreferrer"
        class={buttonVariants({ variant: "default", size: "default" })}
      >
        WhatsApp business
      </a>
    </div>

    <div class="lg:hidden">
      <MobileNav items={items} whatsappHref={whatsappHref} />
    </div>
  </div>
</header>
