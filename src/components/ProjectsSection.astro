---
import Icon from "@/components/Icon.astro";
import ProjectPreviewPlaceholder from "@/components/ProjectPreviewPlaceholder.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { buttonVariants } from "@/components/ui/button";

type Props = {
  projects: {
    eyebrow: string;
    title: string;
    description: string;
    featured: {
      title: string;
      description: string;
      tags: readonly string[];
      href: string;
    };
    archiveTitle: string;
    archiveDescription: string;
  };
};

const { projects } = Astro.props;
---

<section id="projects" class="px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <SectionHeading
      eyebrow={projects.eyebrow}
      title={projects.title}
      description={projects.description}
      align="right"
    />

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <ProjectPreviewPlaceholder />
      </div>

      <article class="surface-card flex flex-col justify-between rounded-[2rem] p-6 sm:p-8">
        <div>
          <div class="flex flex-wrap gap-3">
            {projects.featured.tags.map((tag) => (
              <span class="eyebrow rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_16%,white)] bg-[rgba(245,236,57,0.18)] px-4 py-2 text-[0.65rem] font-semibold text-[color:var(--color-muted-deep)]">
                {tag}
              </span>
            ))}
          </div>
          <div class="mt-8 flex items-start justify-between gap-4">
            <h3 class="font-display text-4xl leading-none text-[color:var(--color-ink)] sm:text-5xl">
              {projects.featured.title}
            </h3>
            <a
              href={projects.featured.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`Open ${projects.featured.title} in a new tab`}
              class="inline-flex size-12 shrink-0 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_22%,transparent)] bg-white/74 text-[color:var(--color-ink)] transition-colors hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
            >
              <Icon name="arrow-up-right" size={18} />
            </a>
          </div>
          <p class="mt-5 text-base leading-7 text-[color:var(--color-copy)]">
            {projects.featured.description}
          </p>
        </div>

        <div class="mt-8">
          <a
            href={projects.featured.href}
            target="_blank"
            rel="noreferrer"
            class={buttonVariants({ variant: "outline", size: "default" })}
          >
            View project placeholder
          </a>
        </div>
      </article>
    </div>

    <div class="surface-card mt-8 rounded-[2rem] p-6 sm:p-8">
      <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
        {projects.archiveTitle}
      </p>
      <div class="mt-5 grid gap-4 md:grid-cols-[1fr_auto] md:items-center">
        <p class="max-w-2xl text-base leading-7 text-[color:var(--color-copy)]">
          {projects.archiveDescription}
        </p>
        <div class="rounded-[1.25rem] border border-dashed border-[color:color-mix(in_oklab,var(--color-muted)_36%,transparent)] px-5 py-4 text-sm text-[color:var(--color-copy)]">
          Empty state ready for the next case study.
        </div>
      </div>
    </div>
  </div>
</section>
