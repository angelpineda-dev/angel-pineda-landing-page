---
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";

type Props = {
  hero: {
    eyebrow: string;
    title: string;
    titleAccent: string;
    description: string;
    ctaLabel: string;
    secondaryCtaLabel: string;
    secondaryCtaHref: string;
    supportingLine: string;
  };
  whatsappHref: string;
};

const { hero, whatsappHref } = Astro.props;
---

<section class="px-4 pb-20 pt-8 sm:px-6 sm:pb-24 lg:pb-28">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-5xl text-center">
      <p class="eyebrow text-xs font-semibold text-[color:var(--color-signal-ink)] sm:text-sm">
        {hero.eyebrow}
      </p>

      <h1 class="mx-auto mt-6 max-w-4xl font-display text-[2.9rem] leading-[0.96] text-[color:var(--color-ink)] sm:text-[4.5rem] lg:text-[5.7rem] lg:leading-[0.94]">
        <span>{hero.title}</span>
        <span class="mt-2 block pb-[0.08em] leading-[1.02] text-[color:var(--color-accent)]">
          {hero.titleAccent}
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-[color:var(--color-copy)] sm:text-lg">
        {hero.description}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noreferrer"
          aria-label="Start the conversation on WhatsApp"
          class={buttonVariants({ variant: "default", size: "lg" })}
        >
          <Icon name="whatsapp" size={20} />
          {hero.ctaLabel}
        </a>
        <a href={hero.secondaryCtaHref} class={buttonVariants({ variant: "outline", size: "default" })}>
          {hero.secondaryCtaLabel}
        </a>
      </div>

      <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-[color:var(--color-copy)] sm:text-base">
        {hero.supportingLine}
      </p>
    </div>
  </div>
</section>
