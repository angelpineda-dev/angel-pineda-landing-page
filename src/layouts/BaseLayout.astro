---
import "@/styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

type Alternate = {
  hreflang: string;
  href: string;
};

type Props = {
  title: string;
  description: string;
  lang: string;
  canonicalURL: string;
  ogImage?: string;
  alternates?: Alternate[];
};

const { title, description, lang, canonicalURL, ogImage, alternates = [] } = Astro.props;

const ogLocale = lang === "en" ? "en_US" : "es_MX";
const isEn = lang === "en";
const SITE_BASE = "https://angelpineda.dev";
const profileImageUrl = `${SITE_BASE}/assets/profile/profile.jpeg`;

// ─── Person (canonical, language-neutral) ────────────────────────────────────
const personSchema = {
  "@type": "Person",
  "@id": `${SITE_BASE}/#person`,
  name: "Angel Pineda",
  url: SITE_BASE,
  email: "angelpdev@gmail.com",
  telephone: "+523317960306",
  image: {
    "@type": "ImageObject",
    "@id": `${SITE_BASE}/#profile-image`,
    url: profileImageUrl,
    width: 800,
    height: 800,
    caption: "Angel Pineda — Software Engineer",
  },
  jobTitle: isEn ? "Software Engineer" : "Ingeniero de Software",
  description: isEn
    ? "Freelance software engineer based in Guadalajara, Mexico. Building product-focused web experiences with strategy, design, development, and deployment under one roof."
    : "Ingeniero de software freelance con base en Guadalajara, México. Construye experiencias web orientadas a producto combinando estrategia, diseño, desarrollo y despliegue en un solo proceso.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Guadalajara",
    addressRegion: "Jalisco",
    addressCountry: "MX",
  },
  areaServed: [
    { "@type": "Country", name: "Mexico" },
    { "@type": "AdministrativeArea", name: "Latin America" },
  ],
  knowsLanguage: ["es-MX", "en"],
  knowsAbout: [
    "Web Development",
    "Software Engineering",
    "Product Strategy",
    "React",
    "Astro",
    "Node.js",
    "Laravel",
    "PHP",
    "Figma",
    "UX Design",
    "Deployment & DevOps",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    "@id": `${SITE_BASE}/#services`,
    name: isEn ? "Web Development Services" : "Servicios de Desarrollo Web",
    itemListElement: isEn
      ? [
          {
            "@type": "Offer",
            "@id": `${SITE_BASE}/#service-discovery`,
            itemOffered: {
              "@type": "Service",
              name: "Discovery",
              description:
                "Understand your business goals, users, and technical requirements before committing to scope.",
            },
          },
          {
            "@type": "Offer",
            "@id": `${SITE_BASE}/#service-design-strategy`,
            itemOffered: {
              "@type": "Service",
              name: "Design and Strategy",
              description:
                "Define the architecture, interface direction, user experience, and the delivery path that can grow with the product.",
            },
          },
          {
            "@type": "Offer",
            "@id": `${SITE_BASE}/#service-development`,
            itemOffered: {
              "@type": "Service",
              name: "Development",
              description:
                "Build fast, modern, and maintainable applications with a strong bias toward clarity and long-term usability.",
            },
          },
          {
            "@type": "Offer",
            "@id": `${SITE_BASE}/#service-deployment`,
            itemOffered: {
              "@type": "Service",
              name: "Deployment",
              description:
                "Launch, optimize, and keep production healthy with a clear handoff and a dependable release approach.",
            },
          },
        ]
      : [
          {
            "@type": "Offer",
            "@id": `${SITE_BASE}/#service-discovery`,
            itemOffered: {
              "@type": "Service",
              name: "Diagnóstico",
              description:
                "Aterrizamos objetivos de negocio, usuarios y requerimientos técnicos antes de comprometer alcance.",
            },
          },
          {
            "@type": "Offer",
            "@id": `${SITE_BASE}/#service-design-strategy`,
            itemOffered: {
              "@type": "Service",
              name: "Diseño y Estrategia",
              description:
                "Definimos arquitectura, dirección visual, experiencia de uso y una ruta de entrega que pueda crecer con el producto.",
            },
          },
          {
            "@type": "Offer",
            "@id": `${SITE_BASE}/#service-development`,
            itemOffered: {
              "@type": "Service",
              name: "Desarrollo",
              description:
                "Construyo aplicaciones modernas, rápidas y mantenibles, con una fuerte preferencia por la claridad y la utilidad a largo plazo.",
            },
          },
          {
            "@type": "Offer",
            "@id": `${SITE_BASE}/#service-deployment`,
            itemOffered: {
              "@type": "Service",
              name: "Despliegue",
              description:
                "Lanzamos, optimizamos y mantenemos producción saludable con una entrega clara y un proceso confiable para publicar cambios.",
            },
          },
        ],
  },
};

// ─── WebSite ──────────────────────────────────────────────────────────────────
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${SITE_BASE}/#website`,
  url: SITE_BASE,
  name: "Angel Pineda",
  description: isEn
    ? "Freelance software engineer — web development, strategy, design, and deployment."
    : "Ingeniero de software freelance — desarrollo web, estrategia, diseño y despliegue.",
  publisher: { "@id": `${SITE_BASE}/#person` },
  inLanguage: isEn ? "en" : "es-MX",
};

// ─── WebPage ──────────────────────────────────────────────────────────────────
const webpageSchema = {
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: title,
  description: description,
  isPartOf: { "@id": `${SITE_BASE}/#website` },
  about: { "@id": `${SITE_BASE}/#person` },
  inLanguage: isEn ? "en" : "es-MX",
  ...(ogImage && {
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: ogImage,
      width: 1200,
      height: 630,
    },
  }),
};

// ─── FAQPage ──────────────────────────────────────────────────────────────────
// Google rich results are restricted to government/healthcare (Aug 2023).
// This block is retained for AI/LLM citation benefit (GEO).
const faqSchema = {
  "@type": "FAQPage",
  "@id": `${canonicalURL}#faq`,
  url: `${canonicalURL}#faq`,
  isPartOf: { "@id": `${SITE_BASE}/#website` },
  inLanguage: isEn ? "en" : "es-MX",
  mainEntity: isEn
    ? [
        {
          "@type": "Question",
          name: "How much does a project cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Pricing is scoped to the specific product. Landing pages and focused web presences typically start around $750–$1,500 USD. Full web applications with custom functionality, integrations, and multi-user flows run higher depending on complexity. Every engagement begins with a discovery conversation to define scope before any number is confirmed, which eliminates budget surprises. The goal is always to build the most useful version that fits the current budget.",
          },
        },
        {
          "@type": "Question",
          name: "How long does development take?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A focused landing page or web presence can ship in three to four weeks. A full product with multiple user flows, third-party integrations, and custom backend logic typically takes eight to sixteen weeks. What adds time: additional user roles, payment gateways, CRM integrations, multi-language support, and extended review cycles. Every project starts with a scoped timeline before development begins.",
          },
        },
        {
          "@type": "Question",
          name: "Can you work with my existing system or team?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. I can collaborate directly in your existing codebase, follow your team's workflow, and integrate with tools like GitHub, Slack, Notion, or Linear. If you have an existing site or application that needs improvement, redesign, or new functionality, that is a common and comfortable starting point. Starting from scratch is not required.",
          },
        },
        {
          "@type": "Question",
          name: "What technologies do you use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The main stack includes React and Astro for frontend development, Node.js and Express for backend APIs, and Laravel and PHP for full-stack applications. For design and prototyping, I use Figma. I also integrate AI-powered features — such as automated workflows, LLM API integrations, and intelligent assistants — when they create real leverage for the product. The technology is always matched to the problem, not the other way around.",
          },
        },
        {
          "@type": "Question",
          name: "What types of businesses do you work with?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Entrepreneurs and independent professionals launching their first web presence. Small and medium-sized businesses that need a new or improved site. Startups and product teams seeking a reliable development partner. Past work includes wellness and healthcare professionals, logistics and operations tooling, and fintech-adjacent platforms. If your project involves building something useful that serves real users, it is a good fit.",
          },
        },
        {
          "@type": "Question",
          name: "Where are you based and do you work remotely?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Based in Guadalajara, Jalisco, Mexico. All client work is done remotely across Mexico and Latin America. Communication happens via WhatsApp, video call, or whatever tools your team already uses. Time zone: CST (UTC-6). Working in both Spanish and English.",
          },
        },
        {
          "@type": "Question",
          name: "What is included in the deployment phase?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Deployment covers the production launch, performance baseline verification, and a clear handoff that describes how to update and maintain the product going forward. For most projects this includes hosting setup, domain configuration, pre-launch checks, and establishing a reliable process for pushing future changes without downtime. You leave with a working product and the confidence to manage it.",
          },
        },
      ]
    : [
        {
          "@type": "Question",
          name: "¿Cuánto cuesta un proyecto?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "El precio se define según el alcance específico del producto. Una presencia web o landing page enfocada suele partir desde $15,000–$30,000 MXN. Una plataforma web con funcionalidades personalizadas, integraciones y flujos multi-usuario tiene un costo mayor dependiendo de la complejidad. Todo empieza con una conversación de diagnóstico para definir el alcance antes de confirmar cualquier número. El objetivo siempre es construir la versión más útil que se ajuste al presupuesto actual.",
          },
        },
        {
          "@type": "Question",
          name: "¿Cuánto tiempo tarda el desarrollo?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Una landing page o presencia web enfocada puede estar lista en tres a cuatro semanas. Una plataforma completa con múltiples flujos de usuario, integraciones con terceros y lógica de backend personalizada suele tomar entre ocho y dieciséis semanas. Lo que suma tiempo: roles de usuario adicionales, pasarelas de pago, integraciones con CRM, soporte multilenguaje y ciclos de revisión extendidos. Cada proyecto comienza con un cronograma claro antes de que inicie el desarrollo.",
          },
        },
        {
          "@type": "Question",
          name: "¿Puedes trabajar con mi sistema o con mi equipo actual?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sí. Puedo colaborar directamente en tu base de código existente, seguir el flujo de trabajo de tu equipo e integrarme con herramientas como GitHub, Slack, Notion o Linear. Si tienes un sitio o aplicación que necesita mejoras, rediseño o nuevas funcionalidades, ese es un punto de partida común y cómodo. No es necesario empezar desde cero.",
          },
        },
        {
          "@type": "Question",
          name: "¿Qué tecnologías utilizas?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "El stack principal incluye React y Astro para desarrollo frontend, Node.js y Express para APIs, y Laravel y PHP para aplicaciones full-stack cuando el proyecto lo requiere. Para diseño y prototipado uso Figma. También integro funcionalidades con inteligencia artificial — como flujos automatizados, integraciones con APIs de LLMs y asistentes inteligentes — cuando generan ventaja real para el producto. La tecnología siempre se adapta al problema, no al revés.",
          },
        },
        {
          "@type": "Question",
          name: "¿Con qué tipos de negocios trabajas?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Emprendedores y profesionales independientes que quieren lanzar su primera presencia digital. Pequeñas y medianas empresas que necesitan un sitio nuevo o mejorado. Startups y equipos de producto que buscan un socio de desarrollo confiable. El trabajo previo incluye profesionales de salud y bienestar, herramientas de logística y operaciones, y plataformas en sectores fintech. Si tu proyecto implica construir algo útil que sirve a usuarios reales, es un buen punto de partida.",
          },
        },
        {
          "@type": "Question",
          name: "¿Dónde estás ubicado y trabajas de forma remota?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Con base en Guadalajara, Jalisco, México. Todo el trabajo con clientes se hace de forma remota para México y Latinoamérica. La comunicación ocurre por WhatsApp, videollamada o las herramientas que ya usa tu equipo. Zona horaria: CST (UTC-6). Trabajo en español e inglés.",
          },
        },
        {
          "@type": "Question",
          name: "¿Qué incluye la fase de despliegue?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "El despliegue cubre el lanzamiento a producción, la verificación del rendimiento base y una entrega clara que describe cómo actualizar y mantener el producto. Para la mayoría de proyectos esto incluye configuración de hosting, dominio, revisiones previas al lanzamiento y un proceso confiable para publicar cambios futuros sin tiempo de inactividad. Sales con un producto funcionando y la confianza para gestionarlo.",
          },
        },
      ],
};

// ─── @graph bundle ────────────────────────────────────────────────────────────
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema, webpageSchema, faqSchema],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Angel Pineda" />
    <meta name="theme-color" content="#F7F8FB" />
    <script is:inline>
      (() => {
        const STORAGE_KEY = "theme";
        const LIGHT_THEME_COLOR = "#F7F8FB";
        const DARK_THEME_COLOR = "#131313";
        const MEDIA_QUERY = "(prefers-color-scheme: dark)";

        try {
          const root = document.documentElement;
          const themeColor = document.querySelector('meta[name="theme-color"]');
          const mediaQuery = window.matchMedia(MEDIA_QUERY);

          const normalizePreference = (value) => {
            if (value === "light" || value === "dark" || value === "system") {
              return value;
            }

            return "system";
          };

          const resolveTheme = (preference) => {
            if (preference === "dark") {
              return true;
            }

            if (preference === "light") {
              return false;
            }

            return mediaQuery.matches;
          };

          const getPreference = () => {
            return normalizePreference(localStorage.getItem(STORAGE_KEY));
          };

          const applyPreference = (preference, persist = true) => {
            const normalizedPreference = normalizePreference(preference);
            const isDark = resolveTheme(normalizedPreference);

            root.dataset.themePreference = normalizedPreference;
            root.classList.toggle("dark", isDark);
            root.style.colorScheme = isDark ? "dark" : "light";
            themeColor?.setAttribute("content", isDark ? DARK_THEME_COLOR : LIGHT_THEME_COLOR);

            if (persist) {
              if (normalizedPreference === "system") {
                localStorage.removeItem(STORAGE_KEY);
              } else {
                localStorage.setItem(STORAGE_KEY, normalizedPreference);
              }
            }

            return { preference: normalizedPreference, isDark };
          };

          const syncSystemTheme = () => {
            if ((root.dataset.themePreference || getPreference()) === "system") {
              applyPreference("system", false);
            }
          };

          applyPreference(getPreference(), false);

          window.__siteTheme = {
            applyPreference,
            getPreference: () => root.dataset.themePreference || getPreference(),
          };

          mediaQuery.addEventListener("change", syncSystemTheme);
        } catch {
          document.documentElement.style.colorScheme = "light";
        }
      })();
    </script>
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={isEn ? "es_MX" : "en_US"} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={title} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={title} />}

    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <SpeedInsights />
  </body>
</html>
