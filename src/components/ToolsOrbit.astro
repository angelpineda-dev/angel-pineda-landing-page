---
type Tool = {
  name: string;
  tone: "signal" | "accent" | "muted";
};

type Props = {
  items: readonly Tool[];
};

const { items } = Astro.props;
const serializedCloudItems = JSON.stringify(items.map((item) => ({ name: item.name, tone: item.tone })));
---

<div class="relative mx-auto aspect-square w-full max-w-[32rem]">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 overflow-hidden rounded-full bg-[radial-gradient(circle_at_center,rgba(0,0,0,0.15)_0%,rgba(255,255,255,0.1)_58%,rgba(255,255,255,0.05)_100%)]"
  >
  
  </div>

  <div
    data-tools-cloud-root
    data-cloud-items={serializedCloudItems}
    class="absolute inset-[-3%] z-10"
  ></div>
</div>

<script>
  import React from "react";
  import { createRoot } from "react-dom/client";
  import { IconCloud } from "@/components/ui/icon-cloud";

  type ToolBadgeItem = {
    name: string;
    tone: "signal" | "accent" | "muted";
  };

  const toolsCloudRoot = document.querySelector("[data-tools-cloud-root]");

  const paletteMap: Record<string, { fill: string; text: string }> = {
    React: { fill: "#61dafb", text: "#10202a" },
    Astro: { fill: "#f5385b", text: "#fff8f2" },
    "Node.js": { fill: "#7bb661", text: "#142316" },
    "Express.js": { fill: "#566c75", text: "#fffef3" },
    PHP: { fill: "#8892bf", text: "#13182b" },
    Laravel: { fill: "#ff5b41", text: "#fff7f2" },
    Figma: { fill: "#1abcfe", text: "#0d1f29" },
    "Artificial Intelligence": { fill: "#f5ec39", text: "#5b5100" },
  };

  function escapeXml(value: string) {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&apos;");
  }

  function fallbackPalette(tone: ToolBadgeItem["tone"]) {
    if (tone === "signal") {
      return { fill: "#f5ec39", text: "#5b5100" };
    }

    if (tone === "accent") {
      return { fill: "#f5385b", text: "#fff8f2" };
    }

    return { fill: "#566c75", text: "#fffef3" };
  }

  function getLabelLayout(name: string) {
    const words = name.split(/\s+/).filter(Boolean);

    if (words.length === 1) {
      return {
        lines: [name],
        fontSize: name.length >= 10 ? 8 : name.length >= 8 ? 9 : 11,
      };
    }

    if (words.length === 2) {
      return {
        lines: words,
        fontSize: words.some((word) => word.length >= 10) ? 6.6 : 7.4,
      };
    }

    return {
      lines: [words.slice(0, 2).join(" "), words.slice(2).join(" ")],
      fontSize: 6.2,
    };
  }

  function buildBadgeImage(item: ToolBadgeItem) {
    const palette = paletteMap[item.name] ?? fallbackPalette(item.tone);
    const { lines, fontSize } = getLabelLayout(item.name);
    const lineHeight = fontSize * 1.1;
    const startY = 32 - (lineHeight * (lines.length - 1)) / 2;
    const labelMarkup = lines
      .map(
        (line, index) =>
          `<tspan x="32" y="${(startY + index * lineHeight).toFixed(1)}">${escapeXml(line)}</tspan>`
      )
      .join("");

    const svg = `
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
        <circle cx="32" cy="32" r="31" fill="${palette.fill}" />
        <circle cx="32" cy="32" r="30.5" stroke="rgba(255,255,255,0.38)" />
        <text
          text-anchor="middle"
          fill="${palette.text}"
          font-family="'Instrument Sans', Arial, sans-serif"
          font-size="${fontSize}"
          font-weight="700"
          letter-spacing="-0.03em"
        >${labelMarkup}</text>
      </svg>
    `;

    return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(svg)}`;
  }

  if (toolsCloudRoot instanceof HTMLDivElement && toolsCloudRoot.dataset.mounted !== "true") {
    toolsCloudRoot.dataset.mounted = "true";

    const reactRoot = createRoot(toolsCloudRoot);
    const cloudItems = JSON.parse(toolsCloudRoot.dataset.cloudItems ?? "[]") as ToolBadgeItem[];
    const images = cloudItems.map(buildBadgeImage);

    reactRoot.render(
      React.createElement(IconCloud, {
        images,
        className: "cursor-grab active:cursor-grabbing",
        iconScale: 0.24,
        radiusScale: 0.35,
      })
    );

    window.addEventListener(
      "pagehide",
      () => {
        reactRoot.unmount();
        delete toolsCloudRoot.dataset.mounted;
      },
      { once: true }
    );
  }
</script>
