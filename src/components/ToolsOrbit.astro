---
type Tool = {
  name: string;
  tone: "signal" | "accent" | "muted";
};

type Props = {
  items: readonly Tool[];
};

const { items } = Astro.props;
const outer = items.slice(0, 5);
const inner = items.slice(5);

function chipTone(tone: Tool["tone"]) {
  switch (tone) {
    case "signal":
      return "border-[rgba(245,236,57,0.35)] bg-[rgba(245,236,57,0.14)] text-[color:var(--color-ink)]";
    case "accent":
      return "border-[rgba(245,56,91,0.22)] bg-[rgba(245,56,91,0.1)] text-[color:var(--color-ink)]";
    default:
      return "border-[rgba(86,108,117,0.24)] bg-[rgba(255,255,255,0.55)] text-[color:var(--color-copy)]";
  }
}
---

<div class="surface-card relative mx-auto flex aspect-square w-full max-w-[34rem] items-center justify-center overflow-hidden rounded-[2.5rem] p-6">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.85),rgba(255,255,255,0.15)_56%,transparent_70%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(245,56,91,0.08),transparent_38%),radial-gradient(circle_at_50%_50%,rgba(245,236,57,0.16),transparent_54%)]"></div>

  <div class="relative flex size-full items-center justify-center">
    {outer.map((tool, index) => {
      const angle = (360 / outer.length) * index;

      return (
        <div
          style={`--angle:${angle}deg;--radius:150px;--duration:28;`}
          class="absolute left-1/2 top-1/2 animate-orbit"
        >
          <div class:list={[
            "flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border px-3 text-center text-[0.72rem] font-semibold leading-4 shadow-[0_12px_30px_rgba(18,23,34,0.08)] backdrop-blur-md",
            chipTone(tool.tone),
          ]}>
            {tool.name}
          </div>
        </div>
      );
    })}

    {inner.map((tool, index) => {
      const angle = (360 / inner.length) * index;

      return (
        <div
          style={`--angle:${angle}deg;--radius:94px;--duration:22;animation-direction:reverse;`}
          class="absolute left-1/2 top-1/2 animate-orbit"
        >
          <div class:list={[
            "flex h-[4.4rem] w-[4.4rem] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border px-2 text-center text-[0.68rem] font-semibold leading-4 shadow-[0_10px_24px_rgba(18,23,34,0.08)] backdrop-blur-md",
            chipTone(tool.tone),
          ]}>
            {tool.name}
          </div>
        </div>
      );
    })}

    <div class="relative z-20 flex size-36 flex-col items-center justify-center rounded-full border border-[rgba(18,23,34,0.08)] bg-[color:var(--color-paper-strong)] text-center shadow-[0_20px_70px_rgba(18,23,34,0.12)]">
      <span class="eyebrow text-[0.6rem] font-semibold text-[color:var(--color-accent)]">
        Core stack
      </span>
      <span class="mt-2 font-display text-3xl text-[color:var(--color-ink)]">Astro</span>
      <span class="mt-1 text-xs text-[color:var(--color-copy)]">Product-first</span>
    </div>
  </div>
</div>
