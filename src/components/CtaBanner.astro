---
import { buttonVariants } from "@/components/ui/button";

type Props = {
  title: string;
  description: string;
  label: string;
  whatsappHref: string;
};

const { title, description, label, whatsappHref } = Astro.props;
---

<section class="px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="surface-card noise-mask relative overflow-hidden rounded-[2.4rem] px-6 py-8 sm:px-10 sm:py-12">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(245,236,57,0.22),transparent_26%),radial-gradient(circle_at_bottom_left,rgba(245,56,91,0.18),transparent_30%)]"></div>
      <div class="relative flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-accent)]">
            Final CTA
          </p>
          <h2 class="mt-4 font-display text-4xl leading-[0.95] text-[color:var(--color-ink)] sm:text-6xl">
            {title}
          </h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-[color:var(--color-copy)] sm:text-lg">
            {description}
          </p>
        </div>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noreferrer"
          class={buttonVariants({ variant: "accent", size: "lg" })}
        >
          {label}
        </a>
      </div>
    </div>
  </div>
</section>
