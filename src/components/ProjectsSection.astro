---
import Icon from "@/components/Icon.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { buttonVariants } from "@/components/ui/button";

type Props = {
  projects: {
    eyebrow: string;
    title: string;
    description: string;
    featured: {
      title: string;
      description: string;
      tags: readonly string[];
      href: string;
      highlights?: {
        currentLabel: string;
        currentDescription: string;
        futureLabel: string;
        futureDescription: string;
        ctaLabel: string;
      };
    };
    archiveTitle: string;
    archiveDescription: string;
  };
};

const { projects } = Astro.props;
---

<section id="projects" class="px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <SectionHeading
      eyebrow={projects.eyebrow}
      title={projects.title}
      description={projects.description}
      align="center"
    />

    <article class="surface-card mt-12 overflow-hidden rounded-[2.35rem] px-6 py-7 sm:px-8 sm:py-8 lg:px-10 lg:py-10">
      <div class="mx-auto max-w-4xl">
        <div class="flex flex-wrap gap-2.5">
          {projects.featured.tags.map((tag) => (
            <span class="rounded-full border border-[color:color-mix(in_oklab,var(--color-frame)_78%,transparent)] bg-[color:color-mix(in_oklab,var(--color-paper-soft)_88%,white)] px-3.5 py-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-[color:var(--color-copy)]">
              {tag}
            </span>
          ))}
        </div>

        <div class="mt-6 max-w-3xl">
          <h3 class="font-display text-[2.55rem] leading-[0.96] text-[color:var(--color-ink)] sm:text-[3.5rem]">
            {projects.featured.title}
          </h3>
          <p class="mt-5 max-w-2xl text-base leading-8 text-[color:var(--color-copy)] sm:text-[1.05rem]">
            {projects.featured.description}
          </p>
        </div>

        {projects.featured.highlights && (
          <dl class="mt-8 grid gap-5 border-t border-[color:color-mix(in_oklab,var(--color-frame)_72%,transparent)] pt-6 text-sm leading-7 text-[color:var(--color-copy)] sm:grid-cols-2">
            <div class="space-y-2">
              <dt class="text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-[color:var(--color-signal-ink)]">
                {projects.featured.highlights.currentLabel}
              </dt>
              <dd>{projects.featured.highlights.currentDescription}</dd>
            </div>

            <div class="space-y-2">
              <dt class="text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-[color:var(--color-accent)]">
                {projects.featured.highlights.futureLabel}
              </dt>
              <dd>{projects.featured.highlights.futureDescription}</dd>
            </div>
          </dl>
        )}

        <div class="mt-8 flex flex-col gap-4 border-t border-[color:color-mix(in_oklab,var(--color-frame)_72%,transparent)] pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-2xl text-sm leading-7 text-[color:var(--color-copy)]">
            Open the project in its own tab to review the current experience without an embedded frame.
          </p>

          <a
            href={projects.featured.href}
            target="_blank"
            rel="noreferrer"
            class={buttonVariants({ variant: "default", size: "default" })}
          >
            {projects.featured.highlights?.ctaLabel ?? "Open project site"}
            <Icon name="arrow-up-right" size={18} />
          </a>
        </div>
      </div>
    </article>

    <div class="mx-auto mt-8 max-w-4xl border-t border-[color:color-mix(in_oklab,var(--color-frame)_72%,transparent)] pt-6 text-center">
      <p class="text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-[color:var(--color-signal-ink)]">
        {projects.archiveTitle}
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-[color:var(--color-copy)] sm:text-base">
        {projects.archiveDescription}
      </p>
    </div>
  </div>
</section>
