---
import { buttonVariants } from "@/components/ui/button";

type Props = {
  hero: {
    eyebrow: string;
    title: string;
    description: string;
    ctaLabel: string;
    supportingLine: string;
    stats: readonly { label: string; value: string }[];
  };
  whatsappHref: string;
};

const { hero, whatsappHref } = Astro.props;
---

<section class="px-4 pb-20 pt-8 sm:px-6 sm:pb-24 lg:pb-28">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
    <div class="relative overflow-hidden rounded-[2.5rem] border border-white/35 bg-[rgba(255,255,255,0.58)] px-6 py-8 shadow-[0_22px_80px_rgba(18,23,34,0.1)] backdrop-blur-xl sm:px-10 sm:py-12 lg:px-12">
      <div class="absolute inset-0 opacity-70 [mask-image:radial-gradient(circle_at_center,black_48%,transparent_100%)]">
        <div class="absolute inset-0 bg-[linear-gradient(rgba(18,23,34,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(18,23,34,0.08)_1px,transparent_1px)] bg-[size:2.75rem_2.75rem]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(245,236,57,0.22),transparent_24%),radial-gradient(circle_at_78%_18%,rgba(245,56,91,0.14),transparent_26%)]"></div>
      </div>
      <div class="relative z-10">
        <p class="eyebrow mb-5 text-xs font-semibold text-[color:var(--color-accent)] sm:text-sm">
          {hero.eyebrow}
        </p>
        <h1 class="font-display text-[2.9rem] leading-[0.9] text-[color:var(--color-ink)] sm:text-[4.5rem] lg:text-[5.8rem]">
          {hero.title}
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-7 text-[color:var(--color-copy)] sm:text-lg">
          {hero.description}
        </p>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noreferrer"
            class={buttonVariants({ variant: "default", size: "lg" })}
          >
            {hero.ctaLabel}
          </a>
          <p class="max-w-xs border-l-2 border-[color:var(--color-accent)] pl-4 text-sm leading-6 text-[color:var(--color-copy)]">
            {hero.supportingLine}
          </p>
        </div>
      </div>
    </div>

    <div class="grid gap-5 lg:pb-4">
      <div class="surface-card noise-mask rounded-[2rem] p-6 sm:p-8">
        <div class="grid gap-5 sm:grid-cols-3">
          {hero.stats.map((stat) => (
            <div class="rounded-[1.5rem] border border-[color:color-mix(in_oklab,var(--color-muted)_16%,transparent)] bg-white/62 p-4">
              <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-muted)]">
                {stat.label}
              </p>
              <p class="mt-2 font-display text-2xl text-[color:var(--color-ink)]">
                {stat.value}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="surface-card noise-mask relative overflow-hidden rounded-[2rem] p-6 sm:p-8">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_20%,rgba(245,236,57,0.22),transparent_24%),radial-gradient(circle_at_15%_100%,rgba(245,56,91,0.15),transparent_32%)]"></div>
        <div class="relative">
          <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-accent)]">
            Delivery posture
          </p>
          <p class="mt-4 font-display text-3xl leading-tight text-[color:var(--color-ink)] sm:text-4xl">
            Product strategy, interface direction, and implementation in one lane.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
