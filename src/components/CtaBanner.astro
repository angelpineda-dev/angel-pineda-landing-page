---
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";

type Props = {
  cta: {
    eyebrow: string;
    title: string;
    description: string;
    label: string;
    note: string;
    ariaLabel: string;
  };
  whatsappHref: string;
};

const { cta, whatsappHref } = Astro.props;
---

<section class="px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="surface-card noise-mask relative overflow-hidden rounded-[2.4rem] px-6 py-8 sm:px-10 sm:py-12">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(3,71,128,0.26),transparent_26%),radial-gradient(circle_at_bottom_left,rgba(191,10,38,0.16),transparent_30%)]"></div>
      <div class="relative flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
            {cta.eyebrow}
          </p>
          <h2 class="mt-4 font-display text-4xl leading-[0.95] text-[color:var(--color-ink)] sm:text-6xl">
            {cta.title}
          </h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-[color:var(--color-copy)] sm:text-lg">
            {cta.description}
          </p>
        </div>

        <div class="flex flex-col items-start gap-3 lg:items-end">
          <p class="text-sm font-medium text-[color:var(--color-copy)] lg:max-w-[15rem] lg:text-right">
            {cta.note}
          </p>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noreferrer"
            aria-label={cta.ariaLabel}
            class:list={[
              buttonVariants({ variant: "accent", size: "lg" }),
              "justify-center",
            ]}
          >
            <Icon name="whatsapp" size={20} />
            {cta.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
