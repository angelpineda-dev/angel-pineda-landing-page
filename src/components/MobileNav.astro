---
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";

type Props = {
  items: readonly { href: string; label: string }[];
  whatsappHref: string;
};

const { items, whatsappHref } = Astro.props;
const dialogId = "mobile-site-nav";
---

<div class="lg:hidden" data-mobile-nav-root>
  <button
    type="button"
    aria-label="Open navigation"
    aria-controls={dialogId}
    aria-expanded="false"
    data-mobile-nav-open
    class="inline-flex size-11 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_42%,transparent)] bg-white/70 text-[color:var(--color-ink)] backdrop-blur-sm transition-colors hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
  >
    <Icon name="menu" size={20} />
  </button>

  <dialog
    id={dialogId}
    data-mobile-nav-dialog
    aria-label="Mobile navigation"
    class="m-0 h-dvh max-h-none w-screen max-w-none border-none bg-transparent p-0 text-inherit"
  >
    <div class="flex min-h-dvh items-start justify-end p-4">
      <div class="mobile-nav-panel w-full max-w-sm rounded-[2rem] border border-white/55 bg-[color:rgba(249,244,236,0.985)] px-5 pb-6 pt-8 shadow-[0_28px_80px_rgba(17,19,27,0.22)] backdrop-blur-2xl">
        <div class="mb-8 flex items-start justify-between gap-4">
          <div>
            <p class="font-display text-lg text-[color:var(--color-ink)]">Angel Pineda</p>
            <p class="mt-1 text-sm text-[color:var(--color-copy)]">
              Software engineer for focused product builds.
            </p>
          </div>

          <button
            type="button"
            aria-label="Close navigation"
            data-mobile-nav-close
            class="inline-flex size-10 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_45%,transparent)] text-[color:var(--color-ink)] transition-colors hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
          >
            <span aria-hidden="true">×</span>
          </button>
        </div>

        <nav class="flex flex-col gap-2">
          {items.map((item) => (
            <a
              href={item.href}
              data-mobile-nav-link
              class="rounded-[1.25rem] px-4 py-3 text-lg font-medium text-[color:var(--color-ink)] transition-colors hover:bg-white/70 hover:text-[color:var(--color-accent)]"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noreferrer"
          data-mobile-nav-link
          class:list={[
            buttonVariants({ variant: "default", size: "lg" }),
            "mt-8 w-full",
          ]}
        >
          WhatsApp business
        </a>
      </div>
    </div>
  </dialog>
</div>

<script>
  const navRoots = document.querySelectorAll("[data-mobile-nav-root]");

  for (const navRoot of navRoots) {
    const dialog = navRoot.querySelector("[data-mobile-nav-dialog]");
    const openButton = navRoot.querySelector("[data-mobile-nav-open]");

    if (!(dialog instanceof HTMLDialogElement) || !(openButton instanceof HTMLButtonElement)) {
      continue;
    }

    const closeButtons = dialog.querySelectorAll("[data-mobile-nav-close]");
    const closeLinks = dialog.querySelectorAll("[data-mobile-nav-link]");

    const syncExpanded = (expanded: boolean) => {
      openButton.setAttribute("aria-expanded", expanded ? "true" : "false");
    };

    openButton.addEventListener("click", () => {
      dialog.showModal();
      syncExpanded(true);
    });

    for (const button of closeButtons) {
      button.addEventListener("click", () => {
        dialog.close();
      });
    }

    for (const link of closeLinks) {
      link.addEventListener("click", () => {
        dialog.close();
      });
    }

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.addEventListener("close", () => {
      syncExpanded(false);
    });
  }
</script>

<style is:global>
  dialog[data-mobile-nav-dialog]::backdrop {
    background: rgba(17, 19, 27, 0.42);
    backdrop-filter: blur(12px);
  }

  dialog[data-mobile-nav-dialog][open] .mobile-nav-panel {
    animation: mobile-nav-in 180ms ease-out;
  }

  @keyframes mobile-nav-in {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
