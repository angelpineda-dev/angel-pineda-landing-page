---
type Props = {
  alt: string;
};

const { alt } = Astro.props;
---

<div class="surface-card relative aspect-[4/5] overflow-hidden rounded-[2rem] p-3 sm:p-4">
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[radial-gradient(circle_at_14%_16%,rgba(3,71,128,0.26),transparent_24%),radial-gradient(circle_at_84%_10%,rgba(191,10,38,0.16),transparent_20%),linear-gradient(180deg,rgba(255,255,255,0.3),rgba(255,255,255,0))]"
  ></div>

  <div class="relative h-full overflow-hidden rounded-[1.65rem] border border-[color:var(--color-frame)] bg-[color:color-mix(in_oklab,var(--color-paper-soft)_72%,var(--color-signal)_28%)] shadow-[inset_0_1px_0_var(--color-inset-highlight)]">
    <img
      src="/assets/profile/profile.jpeg"
      alt={alt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-center"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.08)_0%,rgba(255,255,255,0)_34%,rgba(0,25,58,0.16)_100%)]"
    ></div>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 top-0 h-28 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.34),transparent_72%)] mix-blend-screen"
    ></div>
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-6 top-6 h-px bg-[linear-gradient(90deg,transparent,rgba(255,255,255,0.82),transparent)]"
  ></div>
</div>
