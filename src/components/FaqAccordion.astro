---
type Props = {
  items: readonly { question: string; answer: string }[];
};

const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item, index) => (
    <details
      class="group rounded-[1.5rem] border border-[color:color-mix(in_oklab,var(--color-muted)_20%,transparent)] bg-[color:var(--color-surface)] px-6"
      open={index === 0}
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-base font-semibold text-[color:var(--color-ink)] [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <span class="inline-flex size-7 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_18%,transparent)] text-sm text-[color:var(--color-copy)] transition-transform duration-300 group-open:rotate-45">
          +
        </span>
      </summary>
      <p class="pb-5 pr-8 text-sm leading-7 text-[color:var(--color-copy)]">
        {item.answer}
      </p>
    </details>
  ))}
</div>
