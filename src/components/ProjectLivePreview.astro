---
import { buttonVariants } from "@/components/ui/button";

type ProjectPreview = {
  browserLabel: string;
  status: string;
  note: string;
  fallbackTitle: string;
  fallbackDescription: string;
  openLabel: string;
};

type Props = {
  title: string;
  href: string;
  preview: ProjectPreview;
};

const { title, href, preview } = Astro.props;
---

<div
  class="project-preview-root"
  data-project-preview-root
  data-state="loading"
>
  <div class="project-preview-shell">
    <div class="project-preview-topbar">
      <div class="project-preview-dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <p class="project-preview-domain">{preview.browserLabel}</p>
      <span class="project-preview-badge">{preview.status}</span>
    </div>

    <div class="project-preview-window">
      <div class="project-preview-grid" aria-hidden="true"></div>
      <iframe
        data-project-preview-iframe
        src={href}
        title={`Live preview of ${title}`}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        class="project-preview-iframe"
      ></iframe>

      <div class="project-preview-loading placeholder-sheen" data-project-preview-loading>
        <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
          Loading
        </p>
        <p class="mt-3 max-w-xs text-sm leading-6 text-[color:var(--color-copy)]">
          Bringing the current live build into the preview frame.
        </p>
      </div>

      <div class="project-preview-fallback" data-project-preview-fallback hidden>
        <p class="eyebrow text-[0.62rem] font-semibold text-[color:var(--color-signal-ink)]">
          Preview unavailable
        </p>
        <h4 class="mt-4 font-display text-3xl leading-none text-[color:var(--color-ink)]">
          {preview.fallbackTitle}
        </h4>
        <p class="mt-4 max-w-sm text-sm leading-7 text-[color:var(--color-copy)]">
          {preview.fallbackDescription}
        </p>
        <a
          href={href}
          target="_blank"
          rel="noreferrer"
          class:list={[
            buttonVariants({ variant: "default", size: "default" }),
            "mt-6",
          ]}
        >
          {preview.openLabel}
        </a>
      </div>
    </div>

    <p class="project-preview-note">
      {preview.note}
    </p>
  </div>
</div>

<script>
  const previewRoots = document.querySelectorAll("[data-project-preview-root]");

  for (const root of previewRoots) {
    if (!(root instanceof HTMLElement) || root.dataset.bound === "true") {
      continue;
    }

    root.dataset.bound = "true";

    const iframe = root.querySelector("[data-project-preview-iframe]");
    const loading = root.querySelector("[data-project-preview-loading]");
    const fallback = root.querySelector("[data-project-preview-fallback]");

    if (!(iframe instanceof HTMLIFrameElement) || !(loading instanceof HTMLElement) || !(fallback instanceof HTMLElement)) {
      continue;
    }

    const showLoaded = () => {
      root.dataset.state = "loaded";
      loading.hidden = true;
      fallback.hidden = true;
      iframe.hidden = false;
    };

    const showFallback = () => {
      root.dataset.state = "fallback";
      loading.hidden = true;
      fallback.hidden = false;
      iframe.hidden = true;
    };

    const fallbackTimer = window.setTimeout(showFallback, 7000);

    iframe.addEventListener(
      "load",
      () => {
        window.clearTimeout(fallbackTimer);
        showLoaded();
      },
      { once: true }
    );

    iframe.addEventListener(
      "error",
      () => {
        window.clearTimeout(fallbackTimer);
        showFallback();
      },
      { once: true }
    );

    window.addEventListener(
      "pagehide",
      () => {
        window.clearTimeout(fallbackTimer);
      },
      { once: true }
    );
  }
</script>

<style>
  .project-preview-shell {
    border: 1px solid var(--color-frame);
    border-radius: 2rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-paper-strong) 88%, var(--color-signal) 12%) 0%,
        color-mix(in oklab, var(--color-paper-soft) 86%, var(--color-signal) 14%) 100%
      );
    box-shadow: var(--shadow-strong);
    padding: 0.875rem;
  }

  :global(.dark) .project-preview-shell {
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, #131313 76%, var(--color-signal) 24%) 0%,
        color-mix(in oklab, #131313 84%, var(--color-signal) 16%) 100%
      );
  }

  .project-preview-topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 0.125rem 0.875rem;
  }

  .project-preview-dots {
    display: inline-flex;
    gap: 0.45rem;
  }

  .project-preview-dots span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-muted) 30%, white);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-muted) 55%, transparent);
  }

  .project-preview-dots span:nth-child(1) {
    background: color-mix(in oklab, var(--color-accent) 38%, white);
  }

  .project-preview-dots span:nth-child(2) {
    background: color-mix(in oklab, var(--color-signal) 38%, white);
  }

  .project-preview-dots span:nth-child(3) {
    background: color-mix(in oklab, var(--color-ink) 18%, white);
  }

  .project-preview-domain {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-copy);
  }

  .project-preview-badge {
    border: 1px solid color-mix(in oklab, var(--color-signal) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-signal) 12%, transparent);
    padding: 0.48rem 0.78rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-signal-ink);
  }

  .project-preview-window {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-frame);
    border-radius: 1.5rem;
    background: var(--color-paper-strong);
    aspect-ratio: 16 / 11;
  }

  .project-preview-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-frame) 55%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-frame) 55%, transparent) 1px, transparent 1px);
    background-size: 2.25rem 2.25rem;
    mask-image: linear-gradient(180deg, black, transparent 82%);
    opacity: 0.18;
    z-index: 1;
  }

  .project-preview-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: white;
  }

  .project-preview-loading,
  .project-preview-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    text-align: center;
    z-index: 2;
  }

  .project-preview-loading {
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-paper-strong) 88%, var(--color-signal) 12%) 0%,
        color-mix(in oklab, var(--color-paper-soft) 84%, var(--color-accent) 16%) 100%
      );
  }

  .project-preview-fallback {
    background:
      radial-gradient(circle at top right, rgba(3, 71, 128, 0.18), transparent 28%),
      radial-gradient(circle at bottom left, rgba(191, 10, 38, 0.16), transparent 32%),
      var(--color-paper-strong);
  }

  :global(.dark) .project-preview-fallback {
    background:
      radial-gradient(circle at top right, rgba(3, 71, 128, 0.24), transparent 28%),
      radial-gradient(circle at bottom left, rgba(191, 10, 38, 0.18), transparent 32%),
      color-mix(in oklab, #131313 84%, var(--color-signal) 16%);
  }

  .project-preview-note {
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-copy);
  }

  .project-preview-root[data-state="loaded"] .project-preview-loading {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .project-preview-badge {
      padding-inline: 0.65rem;
      font-size: 0.66rem;
    }
  }
</style>
