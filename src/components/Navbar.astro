---
import BrandLogo from "@/components/BrandLogo.astro";
import Icon from "@/components/Icon.astro";
import type { LandingPageContent } from "@/data/landing";
import { buttonVariants } from "@/components/ui/button";
import MobileNav from "@/components/MobileNav.astro";

type Props = {
  navigation: LandingPageContent["navigation"];
  whatsappHref: string;
  localeHref: string;
};

const { navigation, whatsappHref, localeHref } = Astro.props;
const { items } = navigation;
---

<header class="relative z-40">
  <div aria-hidden="true" class="h-[5.2rem] sm:h-[5.5rem] md:h-[5.7rem] lg:h-[5.95rem]"></div>

  <div class="fixed inset-x-0 top-0 z-40">
    <div class="hidden px-4 pt-4 sm:px-6 md:block">
      <div
        data-desktop-nav-shell
        data-scrolled="false"
        class="mx-auto grid max-w-7xl grid-cols-[auto_1fr_auto] items-center gap-3 rounded-[1.7rem] border border-[color:color-mix(in_oklab,var(--color-muted)_24%,white)] bg-[color:color-mix(in_oklab,var(--color-surface-strong)_84%,white)] px-4 py-[0.9rem] shadow-[0_18px_52px_rgba(2,43,83,0.12)] backdrop-blur-2xl transition-[padding,transform,box-shadow,background-color,border-color] duration-300 lg:gap-5 lg:rounded-[2rem] lg:px-5 lg:py-[0.95rem]"
      >
        <BrandLogo label={navigation.brandLabel} href="#" size="md" />

        <nav class="desktop-nav-group hidden items-center justify-center gap-1 rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_16%,white)] bg-[color:color-mix(in_oklab,var(--color-surface)_86%,white)] p-1.5 md:flex">
          {items.map((item) => (
            <a
              href={item.href}
              data-desktop-nav-link
              data-href={item.href}
              class="desktop-nav-link inline-flex min-w-[4.35rem] items-center justify-center rounded-full px-3 py-1.5 text-[0.8rem] font-semibold text-[color:var(--color-copy)] transition-all duration-200 hover:bg-[color:color-mix(in_oklab,var(--color-signal)_12%,white)] hover:text-[color:var(--color-signal-ink)] lg:min-w-[5.85rem] lg:px-4 lg:py-2 lg:text-sm"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <button
            type="button"
            aria-label={navigation.themeToggleLabel}
            title={navigation.themeToggleLabel}
            data-theme-toggle
            data-theme-label-light={navigation.themeOptions.light}
            data-theme-label-dark={navigation.themeOptions.dark}
            data-theme-label-system={navigation.themeOptions.system}
            data-theme-status-following={navigation.themeStatus.followingDeviceTheme}
            data-theme-status-using-prefix={navigation.themeStatus.usingOverridePrefix}
            data-theme-status-using-suffix={navigation.themeStatus.usingOverrideSuffix}
            class="inline-flex size-10 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_24%,white)] bg-[color:color-mix(in_oklab,var(--color-surface)_88%,white)] text-[color:var(--color-ink)] shadow-[0_10px_24px_rgba(2,43,83,0.08)] transition-colors duration-300 hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
          >
            <span class="inline-flex dark:hidden">
              <Icon name="moon" size={17} />
            </span>
            <span class="hidden dark:inline-flex">
              <Icon name="sun" size={17} />
            </span>
            <span class="sr-only">{navigation.themeToggleLabel}</span>
          </button>

          <a
            href={localeHref}
            data-locale-toggle
            data-locale-href={localeHref}
            aria-label={navigation.localeToggleAriaLabel}
            title={navigation.localeToggleAriaLabel}
            class="language-chip group inline-flex min-h-10 items-center gap-2 rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_24%,white)] bg-[linear-gradient(135deg,color-mix(in_oklab,var(--color-surface)_92%,white),color-mix(in_oklab,var(--color-accent)_8%,white))] px-2.5 shadow-[0_10px_24px_rgba(2,43,83,0.08)] transition-all duration-300 hover:-translate-y-0.5 hover:border-[color:var(--color-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
          >
            <span
              aria-hidden="true"
              class="inline-flex size-7 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-accent)_26%,white)] bg-[color:color-mix(in_oklab,var(--color-accent)_16%,white)] text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[color:var(--color-accent)] transition-colors duration-300 group-hover:bg-[color:color-mix(in_oklab,var(--color-accent)_20%,white)]"
            >
              {navigation.localeToggleLabel}
            </span>
            <span class="hidden pr-1 text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-[color:var(--color-copy)] lg:inline">
              {navigation.localeSectionLabel}
            </span>
          </a>

          <a
            href={whatsappHref}
            target="_blank"
            rel="noreferrer"
            aria-label={navigation.whatsappAriaLabel}
            class:list={[
              buttonVariants({ variant: "default", size: "sm" }),
              "w-10 min-w-0 border border-[color:color-mix(in_oklab,var(--color-signal)_16%,white)] px-0 lg:w-auto lg:min-w-[8.85rem] lg:px-4",
            ]}
          >
            <Icon name="whatsapp" size={18} />
            <span class="hidden lg:inline">{navigation.whatsappLabel}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="md:hidden">
      <MobileNav navigation={navigation} localeHref={localeHref} />
    </div>
  </div>
</header>

<script>
  type ThemePreference = "light" | "dark" | "system";

  const themeWindow = window as typeof window & {
    __siteTheme?: {
      applyPreference?: (preference: ThemePreference) => void;
      getPreference?: () => ThemePreference;
    };
  };

  const getThemeApi = () => {
    return themeWindow.__siteTheme;
  };

  const getThemeLabel = (element: HTMLElement, theme: ThemePreference) => {
    if (theme === "light") {
      return element.dataset.themeLabelLight ?? theme;
    }

    if (theme === "dark") {
      return element.dataset.themeLabelDark ?? theme;
    }

    return element.dataset.themeLabelSystem ?? theme;
  };

  const getThemeTitle = (
    element: HTMLElement,
    preference: ThemePreference,
    resolvedTheme: "light" | "dark"
  ) => {
    if (preference === "system") {
      const following = element.dataset.themeStatusFollowing ?? "Following device theme";
      return `${following} (${getThemeLabel(element, resolvedTheme)})`;
    }

    const prefix = element.dataset.themeStatusUsingPrefix ?? "Using ";
    const suffix = element.dataset.themeStatusUsingSuffix ?? "";
    return `${prefix}${getThemeLabel(element, preference)}${suffix}`.trim();
  };

  const desktopNavShell = document.querySelector("[data-desktop-nav-shell]");
  const desktopNavLinks = Array.from(document.querySelectorAll("[data-desktop-nav-link]")).filter(
    (link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement
  );
  const themeToggleButtons = Array.from(document.querySelectorAll("[data-theme-toggle]")).filter(
    (button): button is HTMLButtonElement => button instanceof HTMLButtonElement
  );
  const themeOptionButtons = Array.from(document.querySelectorAll("[data-theme-option]")).filter(
    (button): button is HTMLButtonElement => button instanceof HTMLButtonElement
  );
  const localeToggleLinks = Array.from(document.querySelectorAll("[data-locale-toggle]")).filter(
    (link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement
  );

  const runThemeTransition = (
    source: HTMLElement,
    nextTheme: ThemePreference,
    themeApi: NonNullable<typeof themeWindow.__siteTheme>
  ) => {
    const { top, left, width, height } = source.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
    const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
    const maxRadius = Math.hypot(Math.max(x, viewportWidth - x), Math.max(y, viewportHeight - y));

    if (typeof document.startViewTransition !== "function") {
      themeApi.applyPreference?.(nextTheme);
      return;
    }

    const transition = document.startViewTransition(() => {
      themeApi.applyPreference?.(nextTheme);
    });

    transition.ready.then(() => {
      document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${maxRadius}px at ${x}px ${y}px)`,
          ],
        },
        {
          duration: 400,
          easing: "ease-in-out",
          pseudoElement: "::view-transition-new(root)",
        }
      );
    });
  };

  const syncThemeControls = () => {
    const themeApi = getThemeApi();
    const preference = themeApi?.getPreference?.() ?? "system";
    const resolvedTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";

    for (const button of themeToggleButtons) {
      button.title = getThemeTitle(button, preference, resolvedTheme);
    }

    for (const button of themeOptionButtons) {
      const option = button.dataset.themeOption as ThemePreference | undefined;
      const isActive = option === preference;
      button.dataset.active = isActive ? "true" : "false";
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    }
  };

  const syncLocaleToggleLinks = () => {
    const currentHash = window.location.hash;

    for (const link of localeToggleLinks) {
      const baseHref = link.dataset.localeHref ?? link.getAttribute("href");

      if (!baseHref) {
        continue;
      }

      link.href = currentHash ? `${baseHref}${currentHash}` : baseHref;
    }
  };

  if (desktopNavShell instanceof HTMLDivElement && desktopNavLinks.length > 0) {
    const desktopMedia = window.matchMedia("(min-width: 768px)");
    const sectionEntries = desktopNavLinks
      .map((link) => {
        const href = link.dataset.href ?? link.getAttribute("href");

        if (!href?.startsWith("#")) {
          return null;
        }

        const section = document.querySelector(href);

        if (!(section instanceof HTMLElement)) {
          return null;
        }

        return { href, link, section };
      })
      .filter((entry): entry is { href: string; link: HTMLAnchorElement; section: HTMLElement } => !!entry);

    let frameId = 0;

    const syncDesktopNav = () => {
      frameId = 0;
      desktopNavShell.dataset.scrolled = window.scrollY > 24 ? "true" : "false";

      if (!desktopMedia.matches || sectionEntries.length === 0) {
        for (const { link } of sectionEntries) {
          link.dataset.active = "false";
          link.removeAttribute("aria-current");
        }
        return;
      }

      const checkpoint = window.innerHeight * 0.24;
      let activeHref: string | null = null;

      for (const entry of sectionEntries) {
        const rect = entry.section.getBoundingClientRect();

        if (rect.top <= checkpoint && rect.bottom > checkpoint * 0.45) {
          activeHref = entry.href;
        }
      }

      for (const entry of sectionEntries) {
        const isActive = activeHref === entry.href;
        entry.link.dataset.active = isActive ? "true" : "false";

        if (isActive) {
          entry.link.setAttribute("aria-current", "location");
        } else {
          entry.link.removeAttribute("aria-current");
        }
      }
    };

    const scheduleDesktopNavSync = () => {
      if (frameId !== 0) {
        return;
      }

      frameId = window.requestAnimationFrame(syncDesktopNav);
    };

    window.addEventListener("scroll", scheduleDesktopNavSync, { passive: true });
    window.addEventListener("resize", scheduleDesktopNavSync);
    scheduleDesktopNavSync();
  }

  if (themeToggleButtons.length > 0 || themeOptionButtons.length > 0) {
    const themeObserver = new MutationObserver(syncThemeControls);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class", "data-theme-preference"],
    });

    syncThemeControls();

    for (const button of themeToggleButtons) {
      if (button.dataset.bound === "true") {
        continue;
      }

      button.dataset.bound = "true";
      button.addEventListener("click", () => {
        const themeApi = getThemeApi();

        if (!themeApi) {
          return;
        }

        const preference = themeApi.getPreference?.() ?? "system";
        const isDark = document.documentElement.classList.contains("dark");
        const nextTheme: ThemePreference = preference === "system" ? (isDark ? "light" : "dark") : "system";

        runThemeTransition(button, nextTheme, themeApi);
      });
    }

    for (const button of themeOptionButtons) {
      if (button.dataset.bound === "true") {
        continue;
      }

      button.dataset.bound = "true";
      const option = button.dataset.themeOption as ThemePreference | undefined;

      if (!option) {
        continue;
      }

      button.addEventListener("click", () => {
        const themeApi = getThemeApi();

        if (!themeApi) {
          return;
        }

        runThemeTransition(button, option, themeApi);
      });
    }
  }

  if (localeToggleLinks.length > 0) {
    syncLocaleToggleLinks();
    window.addEventListener("hashchange", syncLocaleToggleLinks);
  }
</script>

<style is:global>
  [data-desktop-nav-shell][data-scrolled="true"] {
    padding-top: 0.74rem;
    padding-bottom: 0.74rem;
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-accent) 12%, white);
    background: color-mix(in oklab, var(--color-surface-strong) 92%, white);
    box-shadow: 0 26px 68px rgba(2, 43, 83, 0.18);
  }

  [data-desktop-nav-shell][data-scrolled="true"] .desktop-nav-group {
    background: color-mix(in oklab, var(--color-surface) 92%, white);
  }

  .desktop-nav-link[data-active="true"] {
    background: color-mix(in oklab, var(--color-signal) 14%, white);
    color: var(--color-signal-ink);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-signal) 20%, white);
  }

  .dark .desktop-nav-link[data-active="true"] {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-primary) 84%, white 16%),
      0 10px 24px rgba(3, 71, 128, 0.28);
  }

  .dark .language-chip {
    border-color: color-mix(in oklab, var(--color-primary) 34%, white 18%);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-surface-strong) 94%, black 6%),
        color-mix(in oklab, var(--color-primary) 34%, var(--color-surface) 66%)
      );
    box-shadow:
      0 10px 24px rgba(0, 0, 0, 0.24),
      inset 0 0 0 1px color-mix(in oklab, var(--color-primary) 16%, white 10%);
  }

  .dark .language-chip span:first-child {
    border-color: color-mix(in oklab, var(--color-accent) 72%, white 28%);
    background: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .dark .language-chip span:last-child {
    color: var(--color-primary-foreground);
  }

  .language-chip:hover span:first-child {
    border-color: color-mix(in oklab, var(--color-accent) 34%, white);
    color: color-mix(in oklab, var(--color-accent) 88%, black);
  }

  .dark .language-chip:hover span:first-child {
    border-color: color-mix(in oklab, var(--color-accent) 78%, white 22%);
    background: color-mix(in oklab, var(--color-accent) 88%, white 12%);
    color: var(--color-accent-foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-desktop-nav-shell],
    .desktop-nav-link,
    .language-chip,
    .language-chip span,
    [data-theme-option] {
      transition-duration: 1ms;
    }
  }
</style>
