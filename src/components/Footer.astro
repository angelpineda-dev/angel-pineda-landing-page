---
import BrandLogo from "@/components/BrandLogo.astro";
import Icon from "@/components/Icon.astro";
import { buttonVariants } from "@/components/ui/button";

type Props = {
  contact: {
    email: string;
    phoneLabel: string;
    phoneHref: string;
    location: string;
    remoteLabel: string;
    whatsappHref: string;
  };
  footer: {
    blurb: string;
    whatsappLabel: string;
    whatsappAriaLabel: string;
  };
};

const { contact, footer } = Astro.props;
---

<footer
  data-site-footer
  class="border-t border-[color:color-mix(in_oklab,var(--color-muted)_24%,transparent)] px-4 pb-[calc(3rem+env(safe-area-inset-bottom))] pt-12 sm:px-6 sm:pb-16 lg:pb-12"
>
  <div class="mx-auto grid max-w-7xl gap-10 rounded-[2rem] border border-[rgba(205,12,43,0.22)] bg-[linear-gradient(180deg,#002b53,#131313)] px-6 py-8 text-white/82 shadow-[var(--shadow-strong)] sm:px-8 lg:grid-cols-[1.15fr_0.85fr_auto] lg:items-start">
    <div>
      <BrandLogo
        label="Angel Pineda"
        subtitle="Software Engineer"
        surface="dark"
        size="lg"
      />
      <p class="mt-4 max-w-sm text-sm leading-7 text-white/68">
        {footer.blurb}
      </p>
    </div>

    <div class="grid gap-3 text-sm">
      <a href={`mailto:${contact.email}`} class="transition-colors hover:text-[color:var(--color-accent-strong)]">
        {contact.email}
      </a>
      <a href={contact.phoneHref} class="transition-colors hover:text-[color:var(--color-accent-strong)]">
        {contact.phoneLabel}
      </a>
      <p>{contact.location}</p>
      <p class="eyebrow text-[0.62rem] font-semibold text-white/52">
        {contact.remoteLabel}
      </p>
    </div>

    <a
      href={contact.whatsappHref}
      target="_blank"
      rel="noreferrer"
      aria-label={footer.whatsappAriaLabel}
      class:list={[
        buttonVariants({ variant: "accent", size: "default" }),
        "min-w-[9.75rem] justify-center",
      ]}
    >
      <Icon name="whatsapp" size={20} />
      {footer.whatsappLabel}
    </a>
  </div>
</footer>
