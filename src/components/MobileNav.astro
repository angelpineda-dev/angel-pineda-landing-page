---
import Icon from "@/components/Icon.astro";
import type { LandingPageContent } from "@/data/landing";

type Props = {
  navigation: LandingPageContent["navigation"];
  localeHref: string;
};

const { navigation, localeHref } = Astro.props;
const { items } = navigation;
const dialogId = "mobile-site-nav";
---

<div class="md:hidden" data-mobile-nav-root data-open="false" data-scrolled="false">
  <div class="z-40 px-4 pt-4 sm:px-6">
    <div
      data-mobile-nav-shell
      class="mx-auto flex max-w-[30rem] items-center justify-between gap-4 rounded-[1.65rem] border border-[color:color-mix(in_oklab,var(--color-muted)_24%,white)] bg-[color:color-mix(in_oklab,var(--color-surface-strong)_84%,white)] px-4 py-3 shadow-[0_18px_52px_rgba(2,43,83,0.12)] backdrop-blur-2xl transition-[padding,transform,box-shadow,background-color,border-color] duration-300"
    >
      <a href="#" class="flex items-center gap-3 leading-none">
        <span
          aria-hidden="true"
          class="inline-flex size-2.5 rounded-full bg-[color:var(--color-accent)] shadow-[0_0_0_5px_color-mix(in_oklab,var(--color-accent)_14%,white)]"
        ></span>
        <span class="font-display text-[1.15rem] tracking-[-0.03em] text-[color:var(--color-ink)]">
          {navigation.brandLabel}
        </span>
      </a>

      <button
        type="button"
        aria-label={navigation.openNavigationLabel}
        aria-controls={dialogId}
        aria-expanded="false"
        data-mobile-nav-trigger
        data-open="false"
        class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_26%,white)] bg-[color:color-mix(in_oklab,var(--color-surface)_90%,white)] text-[color:var(--color-ink)] shadow-[0_10px_24px_rgba(2,43,83,0.08)] transition-colors duration-300 hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
      >
        <span class="sr-only">{navigation.openNavigationLabel}</span>
        <span class="relative inline-flex size-5 items-center justify-center">
          <span
            data-trigger-bar="top"
            class="absolute h-[1.7px] w-5 -translate-y-[5px] rounded-full bg-current transition-[transform,opacity] duration-300"
          ></span>
          <span
            data-trigger-bar="middle"
            class="absolute h-[1.7px] w-5 rounded-full bg-current transition-[transform,opacity] duration-300"
          ></span>
          <span
            data-trigger-bar="bottom"
            class="absolute h-[1.7px] w-5 translate-y-[5px] rounded-full bg-current transition-[transform,opacity] duration-300"
          ></span>
        </span>
      </button>
    </div>
  </div>

  <dialog
    id={dialogId}
    data-mobile-nav-dialog
    aria-label={navigation.dialogLabel}
    class="m-0 h-dvh max-h-none w-screen max-w-none border-none bg-transparent p-0 text-inherit"
  >
    <div class="flex min-h-dvh justify-end p-3 sm:p-4">
      <div
        data-mobile-nav-panel
        class="mobile-nav-panel flex h-full max-h-[calc(100dvh-1.5rem)] w-full max-w-[22rem] flex-col overflow-hidden rounded-[2rem] border border-[color:color-mix(in_oklab,var(--color-muted)_22%,white)] bg-[color:color-mix(in_oklab,var(--color-surface-strong)_90%,white)] shadow-[0_24px_70px_rgba(2,43,83,0.22)] backdrop-blur-2xl"
      >
        <div class="border-b border-[color:color-mix(in_oklab,var(--color-muted)_18%,transparent)] px-5 pb-4 pt-5">
          <div class="flex items-start justify-between gap-4">
            <p class="font-display text-[1.45rem] tracking-[-0.04em] text-[color:var(--color-ink)]">
              {navigation.brandLabel}
            </p>

            <button
              type="button"
              aria-label={navigation.closeNavigationLabel}
              data-mobile-nav-close
              class="inline-flex min-h-11 cursor-pointer items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_26%,white)] px-4 text-sm font-semibold text-[color:var(--color-ink)] transition-colors duration-300 hover:border-[color:var(--color-accent)] hover:bg-[color:var(--color-accent)] hover:text-[color:var(--color-accent-foreground)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
            >
              {navigation.closeNavigationLabel}
            </button>
          </div>
        </div>

        <div class="flex-1 overflow-y-auto px-5 pb-5 pt-5">
          <nav class="grid gap-2.5">
            {items.map((item) => (
              <a
                href={item.href}
                data-mobile-nav-link
                data-href={item.href}
                class="mobile-menu-link group flex min-h-14 cursor-pointer items-center justify-between gap-3 rounded-[1.35rem] border border-[color:color-mix(in_oklab,var(--color-muted)_16%,transparent)] bg-[color:color-mix(in_oklab,var(--color-surface)_78%,white)] px-4 py-3 text-left transition-all duration-300 hover:border-[color:var(--color-accent)] hover:bg-[color:color-mix(in_oklab,var(--color-accent)_9%,white)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
              >
                <span class="flex items-center gap-3">
                  <span
                    data-mobile-link-icon
                    class="inline-flex size-10 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_22%,white)] bg-[color:color-mix(in_oklab,var(--color-surface-strong)_86%,white)] text-[color:var(--color-ink)] transition-all duration-300"
                  >
                    <Icon name={item.icon} size={18} />
                  </span>
                  <span class="text-[0.96rem] font-semibold text-[color:var(--color-ink)]">
                    {item.label}
                  </span>
                </span>

                <span class="inline-flex size-9 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_16%,transparent)] text-[color:var(--color-copy)] transition-colors duration-300 group-hover:border-[color:var(--color-accent)] group-hover:text-[color:var(--color-accent)]">
                  <Icon name="arrow-right" size={16} />
                </span>
              </a>
            ))}
          </nav>

          <div class="mt-7 grid gap-4 border-t border-[color:color-mix(in_oklab,var(--color-muted)_18%,transparent)] pt-5">
            <div>
              <p class="eyebrow text-[0.58rem] font-semibold text-[color:var(--color-copy)]">
                {navigation.localeSectionLabel}
              </p>

              <a
                href={localeHref}
                data-locale-toggle
                data-locale-href={localeHref}
                aria-label={navigation.localeToggleAriaLabel}
                class="mt-3 inline-flex min-h-12 w-full items-center justify-between rounded-[1.4rem] border border-[color:color-mix(in_oklab,var(--color-muted)_16%,transparent)] bg-[linear-gradient(135deg,color-mix(in_oklab,var(--color-surface)_82%,white),color-mix(in_oklab,var(--color-accent)_10%,white))] px-4 py-3 text-[color:var(--color-ink)] transition-all duration-300 hover:border-[color:var(--color-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
              >
                <span class="text-left text-[0.8rem] font-semibold tracking-[0.06em] text-[color:var(--color-ink)]">
                  {navigation.localeToggleText}
                </span>
                <span class="inline-flex min-w-[2.75rem] items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-accent)_24%,white)] bg-[color:color-mix(in_oklab,var(--color-accent)_16%,white)] px-3 py-2 text-[0.68rem] text-[color:var(--color-accent)]">
                  {navigation.localeToggleLabel}
                </span>
              </a>
            </div>

            <div>
              <p class="eyebrow text-[0.58rem] font-semibold text-[color:var(--color-copy)]">
                {navigation.themeLabel}
              </p>

              <div
                data-theme-option-group
                class="mt-3 grid grid-cols-3 gap-2 rounded-[1.4rem] border border-[color:color-mix(in_oklab,var(--color-muted)_16%,transparent)] bg-[color:color-mix(in_oklab,var(--color-surface)_74%,white)] p-2"
              >
                <button
                  type="button"
                  data-theme-option="light"
                  class="theme-option inline-flex min-h-11 cursor-pointer items-center justify-center rounded-[1rem] px-3 text-[0.76rem] font-semibold text-[color:var(--color-copy)] transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
                >
                  {navigation.themeOptions.light}
                </button>
                <button
                  type="button"
                  data-theme-option="dark"
                  class="theme-option inline-flex min-h-11 cursor-pointer items-center justify-center rounded-[1rem] px-3 text-[0.76rem] font-semibold text-[color:var(--color-copy)] transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
                >
                  {navigation.themeOptions.dark}
                </button>
                <button
                  type="button"
                  data-theme-option="system"
                  class="theme-option inline-flex min-h-11 cursor-pointer items-center justify-center rounded-[1rem] px-3 text-[0.76rem] font-semibold text-[color:var(--color-copy)] transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
                >
                  {navigation.themeOptions.system}
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  const navRoots = document.querySelectorAll("[data-mobile-nav-root]");

  for (const navRoot of navRoots) {
    if (!(navRoot instanceof HTMLDivElement) || navRoot.dataset.bound === "true") {
      continue;
    }

    const trigger = navRoot.querySelector("[data-mobile-nav-trigger]");
    const dialog = navRoot.querySelector("[data-mobile-nav-dialog]");
    const closeButtons = Array.from(navRoot.querySelectorAll("[data-mobile-nav-close]")).filter(
      (button): button is HTMLButtonElement => button instanceof HTMLButtonElement
    );
    const primaryLinks = Array.from(navRoot.querySelectorAll("[data-mobile-nav-link]")).filter(
      (link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement
    );
    const localeLinks = Array.from(navRoot.querySelectorAll("[data-locale-toggle]")).filter(
      (link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement
    );

    if (
      !(trigger instanceof HTMLButtonElement) ||
      !(dialog instanceof HTMLDialogElement) ||
      primaryLinks.length === 0
    ) {
      continue;
    }

    navRoot.dataset.bound = "true";

    const mobileMedia = window.matchMedia("(max-width: 767px)");
    let frameId = 0;

    const sectionEntries = primaryLinks
      .map((link) => {
        const href = link.dataset.href ?? link.getAttribute("href");

        if (!href?.startsWith("#")) {
          return null;
        }

        const section = document.querySelector(href);

        if (!(section instanceof HTMLElement)) {
          return null;
        }

        return { href, link, section };
      })
      .filter((entry): entry is { href: string; link: HTMLAnchorElement; section: HTMLElement } => !!entry);

    const syncExpanded = (expanded: boolean) => {
      trigger.dataset.open = expanded ? "true" : "false";
      trigger.setAttribute("aria-expanded", expanded ? "true" : "false");
      navRoot.dataset.open = expanded ? "true" : "false";
    };

    const syncLocaleLinks = () => {
      const currentHash = window.location.hash;

      for (const link of localeLinks) {
        const baseHref = link.dataset.localeHref ?? link.getAttribute("href");

        if (!baseHref) {
          continue;
        }

        link.href = currentHash ? `${baseHref}${currentHash}` : baseHref;
      }
    };

    const closeDialog = () => {
      if (!dialog.open) {
        syncExpanded(false);
        return;
      }

      dialog.close();
    };

    const openDialog = () => {
      if (!mobileMedia.matches || dialog.open) {
        return;
      }

      dialog.showModal();
      syncExpanded(true);
    };

    const syncActiveLink = () => {
      if (!mobileMedia.matches || sectionEntries.length === 0) {
        for (const { link } of sectionEntries) {
          link.dataset.active = "false";
          link.removeAttribute("aria-current");
        }
        return;
      }

      const checkpoint = window.innerHeight * 0.22;
      let activeHref: string | null = null;

      for (const entry of sectionEntries) {
        const rect = entry.section.getBoundingClientRect();

        if (rect.top <= checkpoint && rect.bottom > checkpoint * 0.5) {
          activeHref = entry.href;
        }
      }

      for (const entry of sectionEntries) {
        const isActive = entry.href === activeHref;
        entry.link.dataset.active = isActive ? "true" : "false";

        if (isActive) {
          entry.link.setAttribute("aria-current", "location");
        } else {
          entry.link.removeAttribute("aria-current");
        }
      }
    };

    const syncShell = () => {
      frameId = 0;
      navRoot.dataset.scrolled = window.scrollY > 18 ? "true" : "false";
      syncActiveLink();
      syncLocaleLinks();

      if (!mobileMedia.matches) {
        closeDialog();
      }
    };

    const scheduleShellSync = () => {
      if (frameId !== 0) {
        return;
      }

      frameId = window.requestAnimationFrame(syncShell);
    };

    trigger.addEventListener("click", () => {
      if (dialog.open) {
        closeDialog();
      } else {
        openDialog();
      }
    });

    for (const button of closeButtons) {
      button.addEventListener("click", closeDialog);
    }

    for (const link of primaryLinks) {
      link.addEventListener("click", () => {
        closeDialog();
      });
    }

    for (const link of localeLinks) {
      link.addEventListener("click", () => {
        closeDialog();
      });
    }

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        closeDialog();
      }
    });

    dialog.addEventListener("close", () => {
      syncExpanded(false);
    });

    window.addEventListener("hashchange", syncLocaleLinks);
    mobileMedia.addEventListener("change", scheduleShellSync);
    window.addEventListener("scroll", scheduleShellSync, { passive: true });
    window.addEventListener("resize", scheduleShellSync);
    scheduleShellSync();
  }
</script>

<style is:global>
  [data-mobile-nav-root][data-scrolled="true"] [data-mobile-nav-shell] {
    padding-top: 0.72rem;
    padding-bottom: 0.72rem;
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-accent) 12%, white);
    background: color-mix(in oklab, var(--color-surface-strong) 92%, white);
    box-shadow: 0 26px 68px rgba(2, 43, 83, 0.18);
  }

  [data-mobile-nav-trigger][data-open="true"] [data-trigger-bar="top"] {
    transform: translateY(0) rotate(45deg);
  }

  [data-mobile-nav-trigger][data-open="true"] [data-trigger-bar="middle"] {
    opacity: 0;
  }

  [data-mobile-nav-trigger][data-open="true"] [data-trigger-bar="bottom"] {
    transform: translateY(0) rotate(-45deg);
  }

  dialog[data-mobile-nav-dialog]::backdrop {
    background: color-mix(in oklab, var(--color-paper) 62%, transparent);
    backdrop-filter: blur(14px);
  }

  dialog[data-mobile-nav-dialog][open] .mobile-nav-panel {
    animation: mobile-sheet-in 220ms ease-out;
  }

  @keyframes mobile-sheet-in {
    from {
      opacity: 0;
      transform: translateX(28px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  .mobile-menu-link[data-active="true"] {
    border-color: color-mix(in oklab, var(--color-accent) 24%, white);
    background: color-mix(in oklab, var(--color-accent) 12%, white);
  }

  .dark .mobile-menu-link[data-active="false"]:hover {
    border-color: color-mix(in oklab, var(--color-primary) 56%, white 18%);
    background: color-mix(in oklab, var(--color-primary) 52%, var(--color-surface) 48%);
    box-shadow: 0 14px 30px rgba(3, 71, 128, 0.18);
  }

  .dark .mobile-menu-link[data-active="false"]:hover > span:first-child > span:last-child {
    color: var(--color-primary-foreground);
  }

  .dark .mobile-menu-link[data-active="false"]:hover [data-mobile-link-icon],
  .dark .mobile-menu-link[data-active="false"]:hover > span:last-child {
    border-color: color-mix(in oklab, var(--color-primary) 72%, white 18%);
    background: color-mix(in oklab, var(--color-primary) 64%, black 36%);
    color: var(--color-primary-foreground);
  }

  .dark .mobile-menu-link[data-active="true"] {
    border-color: color-mix(in oklab, var(--color-primary) 62%, white 18%);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-primary) 92%, black 8%),
        color-mix(in oklab, var(--color-primary) 66%, var(--color-surface) 34%)
      );
    box-shadow:
      0 16px 34px rgba(3, 71, 128, 0.24),
      inset 0 0 0 1px color-mix(in oklab, var(--color-primary) 82%, white 18%);
  }

  .dark .mobile-menu-link[data-active="true"] > span:first-child > span:last-child {
    color: var(--color-primary-foreground);
  }

  .mobile-menu-link[data-active="true"] [data-mobile-link-icon] {
    border-color: color-mix(in oklab, var(--color-accent) 30%, white);
    background: color-mix(in oklab, var(--color-accent) 16%, white);
    color: var(--color-accent);
  }

  .dark .mobile-menu-link[data-active="true"] [data-mobile-link-icon],
  .dark .mobile-menu-link[data-active="true"] > span:last-child {
    border-color: color-mix(in oklab, var(--color-primary) 74%, white 18%);
    background: color-mix(in oklab, var(--color-primary) 66%, black 34%);
    color: var(--color-primary-foreground);
  }

  [data-theme-option][data-active="true"] {
    background: color-mix(in oklab, var(--color-signal) 14%, white);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-signal) 18%, white);
    color: var(--color-signal-ink);
  }

  .dark [data-mobile-nav-panel] [data-locale-toggle] span:last-child {
    border-color: color-mix(in oklab, var(--color-accent) 72%, white 28%);
    background: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .dark [data-theme-option][data-active="true"] {
    background: var(--color-primary);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-primary) 84%, white 16%),
      0 10px 22px rgba(3, 71, 128, 0.24);
    color: var(--color-primary-foreground);
  }

  [data-theme-option][data-active="false"] {
    background: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mobile-nav-shell],
    [data-mobile-nav-trigger] [data-trigger-bar],
    .mobile-menu-link,
    [data-theme-option] {
      transition-duration: 1ms;
    }

    dialog[data-mobile-nav-dialog][open] .mobile-nav-panel {
      animation-duration: 1ms;
    }
  }
</style>
