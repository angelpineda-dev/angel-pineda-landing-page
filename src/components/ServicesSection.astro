---
import Icon from "@/components/Icon.astro";
import SectionHeading from "@/components/SectionHeading.astro";

type Props = {
  services: {
    eyebrow: string;
    title: string;
    description: string;
    items: readonly {
      number: string;
      title: string;
      description: string;
      icon: "search" | "strategy" | "code" | "rocket";
    }[];
  };
};

const { services } = Astro.props;

---

<section id="services" class="px-4 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-7xl">
    <SectionHeading
      eyebrow={services.eyebrow}
      title={services.title}
      description={services.description}
      align="center"
    />

    <div class="mt-12 grid gap-4 xl:gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {services.items.map((service) => {
        return (
          <article class="surface-card group mx-auto flex h-full max-w-sm flex-col items-center rounded-[2rem] p-6 text-center transition-transform duration-300 hover:-translate-y-1 sm:p-7">
            <div class="flex items-center justify-center gap-4">
              <span class="font-display text-4xl text-[color:var(--color-accent)]">
                {service.number}
              </span>
              <span class="flex size-12 items-center justify-center rounded-full border border-[color:color-mix(in_oklab,var(--color-muted)_18%,transparent)] bg-[color:var(--color-surface-strong)] text-[color:var(--color-ink)] transition-colors duration-300 group-hover:border-[color:var(--color-accent)] group-hover:text-[color:var(--color-accent)]">
                <Icon name={service.icon} size={20} />
              </span>
            </div>
            <h3 class="mt-8 font-display text-3xl leading-tight text-[color:var(--color-ink)]">
              {service.title}
            </h3>
            <p class="mt-4 max-w-xs text-sm leading-7 text-[color:var(--color-copy)]">
              {service.description}
            </p>
          </article>
        );
      })}
    </div>
  </div>
</section>
